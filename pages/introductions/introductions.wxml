<view class="page fade-in introductions">
  <view class="page-pad safe-top page-head"><button class="back-button tap" bindtap="goBack" aria-label="返回"><app-icon name="arrow-left" size="22"/></button><view><view class="eyebrow">BREEDING INTRODUCTION</view><view class="title">引种管理</view></view><button class="add-button tap" bindtap="addIntroduction"><app-icon name="plus" size="24"/></button></view>
  <view class="page-pad"><view class="overview"><view><text>累计引种投入</text><strong>¥{{totalCost}}</strong></view><view class="overview-mark"><app-icon name="cockatiel" size="56"/></view></view></view>
  <view class="page-pad month-list" wx:if="{{months.length}}"><view wx:for="{{months}}" wx:key="key" class="month-drawer card"><view class="month-summary tap" data-key="{{item.key}}" bindtap="toggleMonth"><view><view class="month-title">{{item.label}}</view><text>购入 {{item.count}} 只 · ¥{{item.cost}}</text></view><text class="month-chevron {{item.open ? 'open' : ''}}">›</text></view><view wx:if="{{item.open}}" class="month-content"><view wx:for="{{item.parrots}}" wx:for-item="bird" wx:key="id" class="bird-row tap" data-id="{{bird.id}}" bindtap="selectParrot"><image src="{{bird.image}}" mode="aspectFill" lazy-load="true"/><view class="bird-main"><view class="between"><strong>{{bird.species}}</strong><status-badge status="{{bird.status}}" label-override="{{bird.statusLabel}}"/></view><text>{{bird.breed}} · {{bird.genderLabel}} · {{bird.ringLabel}}</text><text>购买于 {{bird.purchaseDate}} · ¥{{bird.price}}</text></view></view></view></view></view>
  <empty-state wx:else title="暂未引种" detail="点击右上角录入第一只外来种鸟"/>
</view>
