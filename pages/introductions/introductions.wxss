.page-head { position: relative; display: flex; align-items: flex-end; gap: 22rpx; padding-bottom: 48rpx; }.page-head .back-button { flex: none; }.add-button { position: absolute; right: 56rpx; bottom: 48rpx; width: 112rpx; height: 112rpx; padding: 0; border-radius: 44rpx; background: #1e293b; color: #fff; }
.overview { position: relative; display: flex; align-items: flex-end; justify-content: space-between; overflow: hidden; padding: 38rpx 42rpx; border-radius: 40rpx; background: linear-gradient(135deg,#60778b,#72889a); color: #fff; }.overview text { display: block; color: rgba(255,255,255,.72); font-size: 20rpx; font-weight: 800; letter-spacing: 2rpx; }.overview strong { display: block; margin-top: 8rpx; font-size: 46rpx; font-variant-numeric: tabular-nums; }.overview-mark { display: flex; align-items: center; justify-content: center; width: 116rpx; height: 116rpx; overflow: hidden; border: 1rpx solid rgba(255,255,255,.82); border-radius: 38rpx; background: #fff; box-shadow: 0 10rpx 22rpx rgba(15,23,42,.12); }
.month-list { padding-top: 30rpx; }.month-drawer { overflow: hidden; margin-bottom: 22rpx; border-radius: 32rpx; }.month-summary { display: flex; align-items: center; justify-content: space-between; padding: 32rpx 34rpx; }.month-title { color: #0f172a; font-size: 28rpx; font-weight: 900; }.month-summary text { display: block; margin-top: 8rpx; color: #64748b; font-size: 20rpx; font-weight: 700; }.month-chevron { margin: 0 !important; color: #94a3b8 !important; font-size: 46rpx !important; transform: rotate(0deg); transition: transform .2s; }.month-chevron.open { transform: rotate(90deg); }.month-content { padding: 0 28rpx 18rpx; border-top: 1rpx solid #f1f5f9; }.bird-row { display: flex; gap: 20rpx; padding: 22rpx 4rpx; border-bottom: 1rpx solid #f8fafc; }.bird-row:last-child { border-bottom: 0; }.bird-row image { width: 112rpx; height: 112rpx; flex: none; border-radius: 24rpx; background: #f1f5f9; }.bird-main { min-width: 0; flex: 1; }.bird-main strong { max-width: 290rpx; overflow: hidden; color: #0f172a; font-size: 26rpx; text-overflow: ellipsis; white-space: nowrap; }.bird-main text { display: block; margin-top: 8rpx; overflow: hidden; color: #64748b; font-size: 19rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }.bird-main status-badge { flex: none; }
