<page-meta page-style="{{showModal ? 'overflow: hidden;' : ''}}" />
<view class="page fade-in">
  <view class="page-pad safe-top head"><view><view class="eyebrow">BREEDING OPERATIONS</view><view class="title">育种管理</view></view></view>
  <view class="page-pad search-row"><view class="search-box"><app-icon class="search-mark" name="search" size="20"/><input value="{{search}}" bindinput="inputSearch" placeholder="搜索品种、名称、圈号..."/></view><button class="quick-reset tap" bindtap="clearSearch">重置</button></view>
  <view class="page-pad pair-section" wx:if="{{pairs.length}}">
    <view class="section-heading"><view><view class="section-eyebrow">ACTIVE PAIRS</view><view class="section-title">进行中的配对</view></view><view class="section-count">{{pairs.length}} 组</view></view>
    <view wx:for="{{pairs}}" wx:key="id" class="pair-card card">
      <view class="pair-card-head"><view><text class="pair-kicker">BREEDING PAIR</text><text class="pair-name">{{item.breed ? item.breed : item.species}}</text></view><view class="flow-status {{item.status === 'INCUBATING' ? 'incubating' : ''}}">{{item.status === 'INCUBATING' ? '孵化中' : '已配对'}}</view></view>
      <view class="pair-flow"><view class="bird"><text class="bird-role">公鸟</text><image class="bird-image tap" src="{{item.male.image}}" mode="aspectFill" data-id="{{item.male.id}}" bindtap="viewParrot"/><strong>{{item.male.species}}</strong><text>圈号：{{item.male.ringLabel}}</text></view><view class="flow-state"><text>↔</text><text class="flow-label">配对中</text></view><view class="bird"><text class="bird-role">母鸟</text><image class="bird-image tap" src="{{item.female.image}}" mode="aspectFill" data-id="{{item.female.id}}" bindtap="viewParrot"/><strong>{{item.female.species}}</strong><text>圈号：{{item.female.ringLabel}}</text></view></view>
      <view class="pair-meta"><text>{{item.breed ? '品种：' + item.breed : '品种待补充'}}</text><text>已配对 {{item.duration}} 天</text></view>
      <view class="pair-actions" wx:if="{{item.status === 'PAIRED'}}"><button class="button-light" disabled="{{submitting}}" data-male="{{item.male.id}}" bindtap="cancelPair">拆对</button><button class="button-dark" disabled="{{submitting}}" data-male="{{item.male.id}}" bindtap="openProgress">推进孵化</button></view>
      <button wx:if="{{item.status === 'INCUBATING'}}" class="view-button" disabled="{{submitting}}" data-ring="{{item.male.ringNumber}}" bindtap="viewHatching">查看孵化进程</button>
    </view>
  </view>
  <view class="page-pad breeder-pool" wx:if="{{breeders.length}}">
    <view class="section-heading"><view><view class="section-eyebrow">BREEDER POOL</view><view class="section-title">可配对种鸟</view></view><view class="section-count">{{breeders.length}} 只</view></view>
    <view class="breeder-grid"><view wx:for="{{breeders}}" wx:key="id" class="breeder-card card tap" data-id="{{item.id}}" bindtap="viewParrot"><image src="{{item.image}}" mode="aspectFill"/><view class="breeder-copy"><view class="breeder-name">{{item.species}}</view><view class="breeder-ring">{{item.breed ? item.breed + ' · ' : ''}}{{item.genderLabel}} · {{item.ringLabel}}</view><view class="breeder-action">查看并配对</view></view></view></view>
  </view>
  <empty-state wx:if="{{!pairs.length && !breeders.length}}" title="{{search ? '未找到匹配的育种档案' : '暂无育种档案'}}" detail="{{search ? '试试品种、名称或圈号' : '先在鹦鹉详情中将鹦鹉设置为种鸟'}}"/>
  <view wx:if="{{showModal}}" class="overlay" bindtap="closeModal"><view class="modal card" catchtap="noop"><view class="between"><text class="modal-title">推进繁育任务</text><text class="close" bindtap="closeModal">×</text></view><text class="modal-detail">{{selected.species}} · {{selected.male.ringNumber}} / {{selected.female.ringNumber}}</text><text class="field-label">蛋数量</text><input class="input" type="number" value="{{eggCount}}" bindinput="inputEgg"/><button class="button-dark modal-submit" disabled="{{submitting}}" bindtap="startIncubation">{{submitting ? '正在启动...' : '确认启动'}}</button></view></view>
</view>
