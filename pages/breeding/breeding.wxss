.head { padding-bottom: 44rpx; }.pair-card { margin-bottom: 28rpx; padding: 36rpx; }.species { color: #0f172a; font-size: 32rpx; font-weight: 900; }.birds { display: flex; align-items: center; justify-content: center; gap: 28rpx; margin: 40rpx 0 26rpx; }.bird { display: flex; flex-direction: column; align-items: center; color: #64748b; font-size: 19rpx; font-weight: 800; }.bird image { width: 172rpx; height: 172rpx; border-radius: 44rpx; background: #f1f5f9; }.bird text { margin-top: 14rpx; }.pair-mark { color: #94a3b8; font-size: 42rpx; font-weight: 300; }.pair-meta { display: flex; justify-content: space-between; padding: 20rpx 0; border-top: 1rpx solid #f1f5f9; color: #94a3b8; font-size: 21rpx; font-weight: 800; }.pair-actions { display: flex; gap: 18rpx; margin-top: 20rpx; }.pair-actions button { flex: 1; height: 84rpx; line-height: 84rpx; font-size: 23rpx; }.view-button { width: 100%; height: 76rpx; line-height: 76rpx; margin-top: 18rpx; color: #0f172a; background: #f8fafc; border-radius: 20rpx; font-size: 22rpx; font-weight: 900; }.overlay { position: fixed; inset: 0; z-index: 60; display: flex; align-items: flex-end; padding: 28rpx; background: rgba(15,23,42,.68); }.modal { width: 100%; padding: 44rpx; border-radius: 40rpx; }.modal-title { color: #0f172a; font-size: 36rpx; font-weight: 900; }.close { color: #94a3b8; font-size: 48rpx; }.modal-detail { display: block; margin: 24rpx 0 44rpx; color: #64748b; font-size: 22rpx; }.field-label { display: block; margin-bottom: 16rpx; color: #64748b; font-size: 22rpx; font-weight: 800; }.modal-submit { width: 100%; height: 92rpx; line-height: 92rpx; margin-top: 34rpx; font-size: 25rpx; }
