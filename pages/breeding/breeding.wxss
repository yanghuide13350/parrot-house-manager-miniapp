.head { padding-bottom:48rpx; }.search-row { display:flex; align-items:center; gap:18rpx; padding-bottom:28rpx; }.search-box { position:relative; flex:1; border:1rpx solid #e2e8f0; border-radius:24rpx; background:#fff; box-shadow:0 8rpx 24rpx -4rpx rgba(30,41,59,.08); }.search-box input { height:92rpx; padding:0 24rpx 0 72rpx; font-size:24rpx; font-weight:700; }.search-mark { position:absolute; top:18rpx; left:24rpx; z-index:1; color:#64748b; font-size:42rpx; }.quick-reset { min-width:112rpx; height:92rpx; padding:0 22rpx; border:1rpx solid #e2e8f0; border-radius:24rpx; background:#fff; color:#64748b; font-size:22rpx; font-weight:900; }.pair-section { padding-top:4rpx; }.section-heading { display:flex; align-items:flex-end; justify-content:space-between; margin:0 0 20rpx; }.section-eyebrow { color:#94a3b8; font-size:18rpx; font-weight:900; letter-spacing:.14em; }.section-title { margin-top:6rpx; color:#0f172a; font-size:30rpx; font-weight:900; }.section-count { padding:10rpx 16rpx; border-radius:14rpx; color:#64748b; background:#f1f5f9; font-size:20rpx; font-weight:900; }.pair-card { margin-bottom:28rpx; padding:28rpx 36rpx 32rpx; }.pair-card-head { display:flex; align-items:center; justify-content:space-between; gap:16rpx; padding-bottom:20rpx; border-bottom:1rpx solid #f1f5f9; }.pair-kicker { display:block; color:#94a3b8; font-size:18rpx; font-weight:900; letter-spacing:.14em; }.pair-name { display:block; margin-top:8rpx; color:#0f172a; font-size:27rpx; font-weight:900; }.pair-flow { display:flex; align-items:center; justify-content:space-between; gap:14rpx; padding:24rpx 0 22rpx; }.bird { display:flex; flex:1; min-width:0; flex-direction:column; align-items:center; color:#64748b; font-size:19rpx; font-weight:800; }.bird-role { margin-bottom:10rpx; color:#94a3b8; font-size:18rpx; letter-spacing:.12em; }.bird image { width:150rpx; height:150rpx; border-radius:40rpx; background:#f1f5f9; }.bird-image:active { opacity:.72; transform:scale(.96); }.bird strong { max-width:100%; margin-top:14rpx; overflow:hidden; color:#0f172a; font-size:24rpx; font-weight:900; text-overflow:ellipsis; white-space:nowrap; }.bird text:last-child { margin-top:8rpx; }.flow-state { display:flex; width:118rpx; flex-direction:column; align-items:center; gap:6rpx; color:#94a3b8; font-size:32rpx; font-weight:700; }.flow-label { color:#94a3b8; font-size:18rpx; font-weight:800; }.flow-status { padding:10rpx 14rpx; border-radius:14rpx; color:#166534; background:#dcfce7; font-size:19rpx; font-weight:900; white-space:nowrap; }.flow-status.incubating { color:#92400e; background:#fef3c7; }.pair-meta { display:flex; justify-content:space-between; gap:16rpx; padding:20rpx 0; border-top:1rpx solid #f1f5f9; color:#94a3b8; font-size:21rpx; font-weight:800; }.pair-meta text:last-child { text-align:right; }.pair-actions { display:flex; gap:18rpx; margin-top:20rpx; }.pair-actions button { flex:1; height:84rpx; line-height:84rpx; font-size:23rpx; }.view-button { width:100%; height:76rpx; line-height:76rpx; margin-top:18rpx; color:#0f172a; background:#f8fafc; border-radius:20rpx; font-size:22rpx; font-weight:900; }.breeder-pool { margin-top:12rpx; padding-top:34rpx; border-top:1rpx solid #e2e8f0; }.overlay { position:fixed; inset:0; z-index:60; display:flex; align-items:flex-end; padding:28rpx; background:rgba(15,23,42,.68); }.modal { width:100%; padding:44rpx; border-radius:40rpx; }.modal-title { color:#0f172a; font-size:36rpx; font-weight:900; }.close { color:#94a3b8; font-size:48rpx; }.modal-detail { display:block; margin:24rpx 0 44rpx; color:#64748b; font-size:22rpx; }.field-label { display:block; margin-bottom:16rpx; color:#64748b; font-size:22rpx; font-weight:800; }.modal-submit { width:100%; height:92rpx; line-height:92rpx; margin-top:34rpx; font-size:25rpx; }
