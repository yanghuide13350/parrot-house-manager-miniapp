.head { padding-bottom: 44rpx; }.pair-card { margin-bottom: 28rpx; padding: 28rpx 36rpx 32rpx; }.pair-heading { display: flex; align-items: baseline; gap: 10rpx; }.species { color: #0f172a; font-size: 30rpx; font-weight: 900; }.pair-heading .pool-detail { color: #94a3b8; font-size: 20rpx; }.pair-flow { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; padding: 18rpx 0 22rpx; }.bird { display: flex; flex: 1; min-width: 0; flex-direction: column; align-items: center; color: #64748b; font-size: 19rpx; font-weight: 800; }.bird-role { margin-bottom: 10rpx; color: #94a3b8; font-size: 18rpx; letter-spacing: .12em; }.bird image { width: 150rpx; height: 150rpx; border-radius: 40rpx; background: #f1f5f9; }.bird-image:active { opacity: .72; transform: scale(.96); }.bird strong { max-width: 100%; margin-top: 14rpx; overflow: hidden; color: #0f172a; font-size: 24rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }.bird text:last-child { margin-top: 8rpx; }.flow-state { display: flex; width: 118rpx; flex-direction: column; align-items: center; gap: 12rpx; color: #94a3b8; font-size: 32rpx; font-weight: 700; }.flow-status { padding: 10rpx 14rpx; border-radius: 14rpx; color: #166534; background: #dcfce7; font-size: 19rpx; font-weight: 900; white-space: nowrap; }.flow-status.incubating { color: #92400e; background: #fef3c7; }.pair-meta { display: flex; justify-content: space-between; padding: 20rpx 0; border-top: 1rpx solid #f1f5f9; color: #94a3b8; font-size: 21rpx; font-weight: 800; }.pair-actions { display: flex; gap: 18rpx; margin-top: 20rpx; }.pair-actions button { flex: 1; height: 84rpx; line-height: 84rpx; font-size: 23rpx; }.view-button { width: 100%; height: 76rpx; line-height: 76rpx; margin-top: 18rpx; color: #0f172a; background: #f8fafc; border-radius: 20rpx; font-size: 22rpx; font-weight: 900; }.overlay { position: fixed; inset: 0; z-index: 60; display: flex; align-items: flex-end; padding: 28rpx; background: rgba(15,23,42,.68); }.modal { width: 100%; padding: 44rpx; border-radius: 40rpx; }.modal-title { color: #0f172a; font-size: 36rpx; font-weight: 900; }.close { color: #94a3b8; font-size: 48rpx; }.modal-detail { display: block; margin: 24rpx 0 44rpx; color: #64748b; font-size: 22rpx; }.field-label { display: block; margin-bottom: 16rpx; color: #64748b; font-size: 22rpx; font-weight: 800; }.modal-submit { width: 100%; height: 92rpx; line-height: 92rpx; margin-top: 34rpx; font-size: 25rpx; }
