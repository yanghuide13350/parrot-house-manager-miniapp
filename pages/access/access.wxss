.access-header { display: flex; align-items: center; gap: 24rpx; padding-bottom: 48rpx; }
.access-title { flex: 1; min-width: 0; }
.policy-switch { transform: scale(.88); transform-origin: right center; }
.access-hero { display: flex; align-items: stretch; justify-content: space-between; padding: 42rpx; border-radius: 40rpx; background: #1e293b; color: #fff; }
.hero-label { color: rgba(255,255,255,.55); font-size: 20rpx; font-weight: 800; letter-spacing: 2rpx; }
.hero-value { margin-top: 12rpx; font-size: 58rpx; font-weight: 900; line-height: 1; }
.hero-caption { margin-top: 10rpx; color: rgba(255,255,255,.62); font-size: 20rpx; font-weight: 800; }
.hero-side { display: flex; align-items: center; gap: 28rpx; padding-left: 28rpx; border-left: 1rpx solid rgba(255,255,255,.14); }
.hero-side view { min-width: 88rpx; text-align: center; }
.hero-side strong { display: block; font-size: 28rpx; font-weight: 900; }
.hero-side text { display: block; margin-top: 8rpx; color: rgba(255,255,255,.55); font-size: 18rpx; font-weight: 700; }
.access-section { margin-top: 28rpx; }
.section-card { padding: 38rpx; }
.request-list, .grant-list { margin-top: 26rpx; }
.request-row, .grant-row { padding: 28rpx; border: 1rpx solid #e8edf2; border-radius: 30rpx; background: #fff; box-shadow: 0 6rpx 20rpx rgba(30,41,59,.045); }
.request-row + .request-row, .grant-row + .grant-row { margin-top: 18rpx; }
.row-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.identity { min-width: 0; flex: 1; }
.openid { color: #0f172a; font-size: 24rpx; font-weight: 900; line-height: 1.45; word-break: break-all; }
.meta { display: block; margin-top: 8rpx; color: #94a3b8; font-size: 18rpx; font-weight: 700; line-height: 1.5; }
.meta-stack { margin-top: 14rpx; }
.meta-line { display: block; color: #94a3b8; font-size: 18rpx; font-weight: 700; line-height: 1.6; }
.note { margin-top: 16rpx; color: #64748b; font-size: 20rpx; font-weight: 700; line-height: 1.6; }
.actions { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 22rpx; }
.action-button { flex: 1 1 220rpx; min-width: 0; height: 80rpx; margin: 0; padding: 0 18rpx; font-size: 22rpx; }
.action-button.danger { color: #be123c; border-color: #fecdd3; background: #fff1f2; }
.request-badge, .role-badge { flex: 0 0 auto; padding: 8rpx 14rpx; border-radius: 14rpx; font-size: 18rpx; font-weight: 900; white-space: nowrap; line-height: 1.2; }
.request-badge { color: #92400e; background: #fef3c7; }
.role-admin { color: #3730a3; background: #e0e7ff; }
.role-member { color: #166534; background: #dcfce7; }
.empty-note { padding: 64rpx 0 18rpx; text-align: center; color: #94a3b8; font-size: 22rpx; font-weight: 800; }
.overlay { position: fixed; inset: 0; z-index: 60; display: flex; align-items: flex-end; padding: 28rpx; background: rgba(15,23,42,.68); }
.reject-modal { width: 100%; max-height: calc(88vh - env(safe-area-inset-bottom)); overflow-y: auto; padding: 44rpx; border-radius: 40rpx; }
.modal-title { color: #0f172a; font-size: 34rpx; font-weight: 900; }
.field-label { display: block; margin: 28rpx 0 14rpx; color: #64748b; font-size: 22rpx; font-weight: 800; }
.reject-textarea { min-height: 180rpx; padding: 24rpx 28rpx; color: #0f172a; font-size: 22rpx; line-height: 1.6; }
.modal-submit, .modal-cancel { width: 100%; height: 92rpx; margin-top: 22rpx; font-size: 24rpx; }
