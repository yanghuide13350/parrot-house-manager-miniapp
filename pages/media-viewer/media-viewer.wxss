page { background: #05070a; }
.viewer-page { position: relative; min-height: 100vh; overflow: hidden; color: #fff; background: #05070a; }
.viewer-top { position: absolute; top: calc(24rpx + env(safe-area-inset-top)); left: 24rpx; right: 24rpx; z-index: 6; min-height: 88rpx; }
.viewer-back { display: inline-flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; margin: 0; padding: 0; border: 1rpx solid rgba(226,232,240,.94); border-radius: 22rpx; color: #0f172a; background: rgba(255,255,255,.98); box-shadow: 0 12rpx 24rpx rgba(0,0,0,.16); line-height: 1; }
.viewer-title { position: absolute; left: 50%; top: 8rpx; width: 360rpx; transform: translateX(-50%); text-align: center; pointer-events: none; }
.viewer-title text { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.viewer-title text:first-child { color: rgba(255,255,255,.54); font-size: 17rpx; font-weight: 800; letter-spacing: 3rpx; }
.viewer-title text:last-child { margin-top: 10rpx; color: #fff; font-size: 26rpx; font-weight: 900; }
.viewer-stage { position: relative; display: flex; align-items: center; justify-content: center; width: 100%; height: calc(100vh - 116rpx - env(safe-area-inset-bottom)); min-height: 720rpx; overflow: hidden; background: #000; }
.viewer-video { width: 100%; height: 100%; background: #000; }
.viewer-loading, .viewer-error { display: flex; flex-direction: column; align-items: center; justify-content: center; color: #7f8a9b; font-size: 22rpx; font-weight: 700; }
.loading-ring { width: 58rpx; height: 58rpx; margin-bottom: 24rpx; border: 5rpx solid #252c36; border-top-color: #fff; border-radius: 50%; animation: spin .8s linear infinite; }
.error-mark { display: flex; align-items: center; justify-content: center; width: 84rpx; height: 84rpx; border-radius: 50%; color: #fb7185; background: rgba(190,18,60,.2); font-size: 42rpx; font-weight: 900; }
.error-title { margin-top: 28rpx; color: #fff; font-size: 28rpx; font-weight: 900; }
.error-detail { margin-top: 12rpx; color: #7f8a9b; font-size: 20rpx; }
.viewer-foot { display: flex; align-items: center; justify-content: center; min-height: calc(116rpx + env(safe-area-inset-bottom)); padding: 22rpx 36rpx calc(22rpx + env(safe-area-inset-bottom)); color: #7f8a9b; background: #05070a; font-size: 19rpx; font-weight: 700; text-align: center; }
@keyframes spin { to { transform: rotate(360deg); } }
