.supplies-page { min-height: 100vh; }.page-head { position: relative; display: flex; align-items: flex-end; gap: 22rpx; padding-bottom: 48rpx; }.add-button { position: absolute; right: 56rpx; bottom: 48rpx; width: 112rpx; height: 112rpx; padding: 0; border-radius: 44rpx; background: #1e293b; color: #fff; }
.tabs { display: flex; padding: 8rpx; border-radius: 24rpx; background: #eef2f5; }.tab { display: flex; flex: 1; align-items: center; justify-content: center; gap: 10rpx; height: 72rpx; border-radius: 18rpx; color: #64748b; font-size: 22rpx; font-weight: 900; }.tab.active { background: #fff; color: #1e293b; box-shadow: 0 4rpx 12rpx rgba(30,41,59,.08); }
.month-list { padding-top: 30rpx; }.month-drawer { overflow: hidden; margin-bottom: 22rpx; border-radius: 32rpx; }.month-summary { display: flex; align-items: center; justify-content: space-between; padding: 32rpx 34rpx; }.month-title { color: #0f172a; font-size: 28rpx; font-weight: 900; }.month-summary text { display: block; margin-top: 8rpx; color: #64748b; font-size: 20rpx; font-weight: 700; }.month-chevron { margin: 0 !important; color: #94a3b8 !important; font-size: 46rpx !important; transform: rotate(0deg); transition: transform .2s; }.month-chevron.open { transform: rotate(90deg); }.month-content { padding: 0 28rpx 18rpx; border-top: 1rpx solid #f1f5f9; }
.record-row { display: flex; gap: 20rpx; padding: 22rpx 4rpx; border-bottom: 1rpx solid #f8fafc; }.record-row:last-child { border-bottom: 0; }.record-icon { display: flex; align-items: center; justify-content: center; width: 84rpx; height: 84rpx; flex: none; border-radius: 24rpx; background: #f1f5f9; color: #64748b; }.record-main { display: flex; min-width: 0; min-height: 84rpx; flex: 1; flex-direction: column; justify-content: center; }.record-main strong { max-width: 310rpx; overflow: hidden; color: #0f172a; font-size: 26rpx; text-overflow: ellipsis; white-space: nowrap; }.record-main .record-amount { max-width: none; color: #1e293b; font-variant-numeric: tabular-nums; }.record-meta { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 8rpx; color: #64748b; font-size: 19rpx; font-weight: 700; }.record-meta text { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.record-meta text:last-child { text-align: right; }.record-main .record-note { display: block; margin-top: 6rpx; overflow: hidden; color: #94a3b8; font-size: 19rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.form-overlay { position: fixed; z-index: 30; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: flex-end; background: rgba(15,23,42,.38); }.form-sheet { width: 100%; overflow: hidden; border-radius: 40rpx 40rpx 0 0; background: #f8fafc; }.form-head { position: relative; display: flex; align-items: center; justify-content: space-between; padding: 36rpx 36rpx 22rpx; background: #fff; }.form-handle { position: absolute; top: 14rpx; left: 50%; width: 64rpx; height: 8rpx; border-radius: 99rpx; background: #dbe2ea; transform: translateX(-50%); }.form-kind { color: #64748b; font-size: 19rpx; font-weight: 900; letter-spacing: 2rpx; }.form-title { margin-top: 7rpx; color: #0f172a; font-size: 32rpx; font-weight: 900; }.close-button { display: flex !important; flex: 0 0 56rpx !important; align-items: center !important; justify-content: center !important; width: 56rpx !important; min-width: 56rpx !important; max-width: 56rpx !important; height: 56rpx !important; min-height: 56rpx !important; margin: 0 !important; padding: 0 !important; border: 0 !important; border-radius: 18rpx !important; background: #f1f5f9 !important; color: #64748b; font-size: 38rpx; font-weight: 300; line-height: 1 !important; }.form-body { padding: 0 28rpx 18rpx; box-sizing: border-box; }.field { margin-top: 14rpx; padding: 20rpx 24rpx; border: 1rpx solid #eef2f6; border-radius: 22rpx; background: #fff; }.field > text { display: block; color: #64748b; font-size: 19rpx; font-weight: 900; }.field-row { display: flex; gap: 14rpx; }.field-row .field { min-width: 0; flex: 1; }.required { display: inline; color: #c65d67; }.field input { height: 48rpx; margin-top: 6rpx; color: #0f172a; font-size: 25rpx; font-weight: 800; }.amount-input { display: flex; align-items: center; gap: 8rpx; color: #475569; font-size: 27rpx; font-weight: 900; }.amount-input input { min-width: 0; flex: 1; }.picker-value { display: flex; align-items: center; justify-content: space-between; height: 48rpx; margin-top: 6rpx; color: #0f172a; font-size: 25rpx; font-weight: 800; }.note-field textarea { display: block; box-sizing: border-box; width: 100%; height: 58rpx; min-height: 58rpx; margin-top: 8rpx; color: #0f172a; font-size: 23rpx; line-height: 1.5; }.form-footer { padding: 16rpx 28rpx calc(18rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #edf0f2; background: #fff; }.save-button { width: 100%; height: 84rpx; border-radius: 22rpx; font-size: 24rpx; }
