<page-meta page-style="{{showForm ? 'overflow: hidden;' : ''}}" />
<view class="page fade-in supplies-page">
  <view class="page-pad safe-top page-head"><button class="back-button tap" bindtap="goBack" aria-label="返回"><app-icon name="arrow-left" size="22"/></button><view><view class="eyebrow">SUPPLIES & MEDICINE</view><view class="title">耗材管理</view></view><button class="add-button tap" bindtap="add" aria-label="新增记录"><app-icon name="plus" size="24"/></button></view>
  <view class="page-pad"><view class="tabs"><view class="tab tap {{activeTab === 'SUPPLY' ? 'active' : ''}}" data-tab="SUPPLY" bindtap="switchTab"><app-icon name="package" size="18"/>日常耗材</view><view class="tab tap {{activeTab === 'MEDICINE' ? 'active' : ''}}" data-tab="MEDICINE" bindtap="switchTab"><app-icon name="cross" size="18"/>药品</view></view></view>
  <view class="page-pad month-list" wx:if="{{currentMonths.length}}"><view wx:for="{{currentMonths}}" wx:key="key" class="month-drawer card"><view class="month-summary tap" data-key="{{item.key}}" bindtap="toggleMonth"><view><view class="month-title">{{item.label}}</view><text>{{item.count}} 笔 · ¥{{item.amount}}</text></view><text class="month-chevron {{item.open ? 'open' : ''}}">›</text></view><view wx:if="{{item.open}}" class="month-content"><view wx:for="{{item.items}}" wx:for-item="record" wx:key="id" class="record-row"><view class="record-icon"><app-icon name="{{currentIcon}}" size="22"/></view><view class="record-main"><view class="between"><strong>{{record.name}}</strong><strong class="record-amount">¥{{record.amount}}</strong></view><view class="record-meta"><text>{{record.purchaseDate}}</text><text wx:if="{{record.weight}}">{{record.weight}}</text></view><text wx:if="{{record.notes}}" class="record-note">{{record.notes}}</text></view></view></view></view></view>
  <empty-state wx:else title="暂无{{currentLabel}}记录" detail="点击右上角添加一笔记录"/>
  <view wx:if="{{showForm}}" class="form-overlay" bindtap="closeForm"><view class="form-sheet" catchtap="noop"><view class="form-head"><view class="form-handle"></view><view><view class="form-kind">新增{{currentLabel}}</view><view class="form-title">记录一笔购买</view></view><button class="close-button tap" bindtap="closeForm" aria-label="关闭">×</button></view><view class="form-body"><view class="field"><text>名称 <text class="required">*</text></text><input data-key="name" value="{{form.name}}" bindinput="input" placeholder="{{activeTab === 'SUPPLY' ? '如：鸟粮、笼子、谷子' : '如：电解质、胃炎药'}}"/></view><view class="field-row"><view class="field"><text>金额 <text class="required">*</text></text><view class="amount-input"><text>¥</text><input type="digit" data-key="amount" value="{{form.amount}}" bindinput="input" placeholder="0.00"/></view></view><view class="field"><text>重量</text><input data-key="weight" value="{{form.weight}}" bindinput="input" placeholder="如：500g、2kg"/></view></view><view class="field"><text>购买时间</text><picker mode="date" value="{{form.purchaseDate}}" end="{{todayDate}}" bindchange="dateChange"><view class="picker-value">{{form.purchaseDate}}<app-icon name="calendar" size="18"/></view></picker></view><view class="field note-field"><text>备注</text><textarea data-key="notes" value="{{form.notes}}" bindinput="input" placeholder="选填" maxlength="1000"/></view></view><view class="form-footer"><button class="button-dark save-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="save">保存记录</button></view></view></view>
</view>
