.feeding-page { min-height: 100vh; padding-bottom: calc(52rpx + env(safe-area-inset-bottom)); background: #f8f6f1; }
.library-header { display: flex; align-items: center; gap: 22rpx; padding-bottom: 48rpx; }.library-header > view { flex: 1; }
.plans { margin-top: 34rpx; }.plan-surface { overflow: hidden; border: 1rpx solid #e9e4d9; border-radius: 36rpx; background: #fffdfa; box-shadow: 0 14rpx 32rpx rgba(26, 38, 61, .06); }.plan-row { display: flex; align-items: center; gap: 24rpx; min-height: 176rpx; padding: 24rpx 26rpx; border-bottom: 1rpx solid #eee9df; }.plan-row:last-child { border-bottom: 0; }.plan-image { flex: 0 0 116rpx; width: 116rpx; height: 116rpx; border-radius: 28rpx; background: #e8e4da; }
.plan-main { min-width: 0; flex: 1; }.plan-title { overflow: hidden; color: #17243b; font-size: 29rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }.enabled-mark { display: inline-block; margin-left: 10rpx; padding: 4rpx 10rpx; border-radius: 10rpx; background: #e1eadf; color: #42614c; font-size: 16rpx; vertical-align: 3rpx; }.plan-subtitle { overflow: hidden; margin-top: 10rpx; color: #7d8490; font-size: 20rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }.plan-facts { display: flex; gap: 16rpx; margin-top: 15rpx; color: #526174; font-size: 19rpx; font-weight: 800; }.plan-facts text + text { padding-left: 16rpx; border-left: 1rpx solid #dcdfe1; }.plan-actions { display: flex; align-items: center; gap: 14rpx; margin-top: 20rpx; }.action-button { height: 58rpx; padding: 0 22rpx; border: 1rpx solid #d9ded9; border-radius: 18rpx; background: #fff; color: #405168; font-size: 20rpx; font-weight: 900; }.action-delete { border-color: #e5c8cb; color: #a6515a; }.plan-switch { display: flex; align-items: center; gap: 10rpx; margin-left: auto; color: #627084; font-size: 18rpx; }.plan-switch switch { transform: scale(.76); transform-origin: right center; }
.empty { padding: 76rpx 36rpx 54rpx; text-align: center; color: #27364b; font-size: 28rpx; font-weight: 900; }.empty text { display: block; margin-top: 14rpx; color: #8a919b; font-size: 21rpx; font-weight: 700; }.empty-mark { width: 72rpx; height: 72rpx; margin: 0 auto 24rpx; border-radius: 22rpx; background: #e1eadf; color: #42614c; font-size: 50rpx; font-weight: 300; line-height: 66rpx; }.empty-add { width: 100%; height: 88rpx; margin-top: 36rpx; border-radius: 25rpx; font-size: 24rpx; }
.form-overlay { align-items: flex-end; background: rgba(15, 24, 42, .42); }.form-shell { display: flex; flex-direction: column; width: 100%; height: calc(91vh - env(safe-area-inset-bottom)); overflow: hidden; border-radius: 46rpx 46rpx 0 0; background: #fbfaf6; }.form-top { display: flex; align-items: flex-start; justify-content: space-between; padding: 42rpx 38rpx 24rpx; background: #132039; }.form-top .form-overline { color: #d8c797; }.form-title { margin-top: 10rpx; color: #fff; font-size: 36rpx; font-weight: 900; }.close-button { width: 64rpx; height: 64rpx; margin: 0; padding: 0; border: 1rpx solid rgba(255,255,255,.22); border-radius: 50%; background: transparent; color: #fff; font-size: 42rpx; font-weight: 300; line-height: 56rpx; }
.stepper { display: flex; align-items: flex-start; padding: 26rpx 38rpx 24rpx; background: #132039; }.step-item { width: 112rpx; color: #8994a4; font-size: 18rpx; font-weight: 800; }.step-item text { display: block; width: 38rpx; height: 38rpx; margin-bottom: 10rpx; border: 1rpx solid #687486; border-radius: 50%; font-size: 17rpx; line-height: 38rpx; text-align: center; }.step-item.active { color: #fff; }.step-item.active text { border-color: #d8c797; background: #d8c797; color: #132039; }.step-line { flex: 1; height: 1rpx; margin: 19rpx 8rpx 0; background: #465266; }.step-line.active { background: #d8c797; }
.form-body { height: 0; flex: 1; }.form-section { padding: 40rpx 34rpx 50rpx; }.section-title { margin-top: 14rpx; color: #17243b; font-size: 34rpx; font-weight: 900; }.section-copy { margin-top: 12rpx; color: #7d8490; font-size: 22rpx; line-height: 1.55; }.field-card, .note-card { box-sizing: border-box; margin-top: 22rpx; padding: 21rpx 24rpx; border: 1rpx solid #e5e1d9; border-radius: 24rpx; background: #fff; }.field-card text, .note-card text { display: block; color: #697687; font-size: 19rpx; font-weight: 900; }.field-card input { height: 48rpx; margin-top: 9rpx; color: #1d2a40; font-size: 25rpx; font-weight: 800; }.split-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }.split-fields .field-card { min-width: 0; }.note-card textarea { display: block; box-sizing: border-box; width: 100%; min-height: 116rpx; margin-top: 12rpx; color: #1d2a40; font-size: 23rpx; line-height: 1.55; }.delete-plan { display: block; margin: 34rpx auto 0; padding: 12rpx 22rpx; background: transparent; color: #b24c57; font-size: 21rpx; font-weight: 800; }
.form-footer { display: flex; gap: 18rpx; padding: 20rpx 34rpx calc(22rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e9e5dc; background: #fffdfa; }.previous, .next { height: 88rpx; border-radius: 24rpx; font-size: 24rpx; font-weight: 900; }.previous { flex: 0 0 150rpx; border: 1rpx solid #d5d8d4; background: #fff; color: #425166; }.next { flex: 1; }
