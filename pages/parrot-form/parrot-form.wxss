.form-head { display: flex; align-items: center; gap: 24rpx; padding-bottom: 44rpx; }.back-button { width: 88rpx; height: 88rpx; line-height: 82rpx; padding: 0; border-radius: 28rpx; background: #fff; border: 1rpx solid #e2e8f0; color: #0f172a; font-size: 48rpx; }.media-card, .form-card { padding: 40rpx; margin-bottom: 28rpx; }.section-label { color: #0f172a; font-size: 20rpx; font-weight: 900; letter-spacing: 2rpx; }.media-actions { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18rpx; margin-top: 28rpx; }.media-action { text-align: center; color: #334155; font-size: 19rpx; font-weight: 800; }.media-icon { display: flex; align-items: center; justify-content: center; width: 100%; aspect-ratio: 1; border: 1rpx solid #e2e8f0; border-radius: 22rpx; font-size: 38rpx; font-weight: 300; }.media-icon.gray { background: #f1f5f9; }.media-icon.blue { color: #1e40af; background: #dbeafe; }.media-icon.green { color: #166534; background: #dcfce7; }.media-icon.dashed { color: #94a3b8; background: #f8fafc; border: 2rpx dashed #cbd5e1; }.media-action text { display: block; margin-top: 12rpx; }.media-preview { position: relative; height: 150rpx; margin-top: 20rpx; overflow: hidden; border-radius: 22rpx; background: #f1f5f9; }.media-preview image, .media-preview video { width: 100%; height: 100%; }.remove-media { position: absolute; top: 8rpx; right: 8rpx; width: 44rpx; height: 44rpx; line-height: 40rpx; padding: 0; border-radius: 50%; background: #e11d48; color: #fff; font-size: 28rpx; }.url-box { margin-top: 28rpx; padding: 24rpx; border-radius: 24rpx; background: #f8fafc; }.url-actions { display: flex; gap: 16rpx; margin-top: 18rpx; }.url-actions button { flex: 1; height: 76rpx; line-height: 76rpx; font-size: 22rpx; }.field-label { display: block; margin: 30rpx 0 14rpx; color: #0f172a; font-size: 21rpx; font-weight: 900; letter-spacing: 1rpx; }.gender-tabs { display: flex; gap: 8rpx; padding: 8rpx; border-radius: 20rpx; background: #f1f5f9; }.gender-tab { flex: 1; padding: 22rpx 8rpx; border-radius: 16rpx; text-align: center; color: #64748b; font-size: 21rpx; font-weight: 800; }.gender-tab.active { color: #0f172a; background: #fff; box-shadow: 0 6rpx 14rpx rgba(30,41,59,.08); }.two-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }.picker { padding: 26rpx 28rpx; border-radius: 24rpx; background: #f8fafc; border: 1rpx solid #e2e8f0; color: #334155; font-size: 23rpx; font-weight: 800; }.textarea { width: 100%; min-height: 260rpx; padding: 24rpx; border: 1rpx solid #e2e8f0; border-radius: 24rpx; background: #f8fafc; color: #0f172a; font-size: 24rpx; font-weight: 700; }.submit { width: calc(100% - 112rpx); height: 104rpx; line-height: 104rpx; margin: 0 56rpx; font-size: 27rpx; }
