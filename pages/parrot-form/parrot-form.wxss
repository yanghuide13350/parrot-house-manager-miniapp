.form-head { display: flex; align-items: center; gap: 24rpx; padding-bottom: 48rpx; }
.back-button { width: 88rpx; height: 88rpx; line-height: 82rpx; padding: 0; border-radius: 28rpx; background: #fff; border: 1rpx solid #e2e8f0; color: #0f172a; font-size: 48rpx; }
.media-card, .form-card { padding: 40rpx; margin-bottom: 28rpx; }
.section-label { color: #0f172a; font-size: 20rpx; font-weight: 900; letter-spacing: 2rpx; }
.media-actions { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18rpx; margin-top: 28rpx; }
.media-action { text-align: center; color: #334155; font-size: 19rpx; font-weight: 800; }
.media-icon { display: flex; align-items: center; justify-content: center; width: 100%; aspect-ratio: 1; border: 1rpx solid #e2e8f0; border-radius: 22rpx; font-size: 38rpx; font-weight: 300; }
.media-icon.gray { background: #f1f5f9; }
.media-icon.green { color: #166534; background: #dcfce7; }
.media-icon.dashed { color: #94a3b8; background: #f8fafc; border: 2rpx dashed #cbd5e1; }
.media-action text { display: block; margin-top: 12rpx; }
.media-preview { position: relative; height: 0; padding-top: 100%; overflow: hidden; border-radius: 22rpx; background: #f1f5f9; }
.media-preview image, .video-preview, .upload-placeholder { position: absolute; inset: 0; width: 100%; height: 100%; }
.video-thumb { width: 100%; height: 100%; }
.media-uploading { background: #f8fafc; border: 1rpx dashed #94a3b8; }
.upload-placeholder { display: flex; flex-direction: column; align-items: center; justify-content: center; color: #475569; font-size: 20rpx; font-weight: 800; }
.upload-spinner { width: 38rpx; height: 38rpx; margin-bottom: 12rpx; border: 4rpx solid #d7e0ea; border-top-color: #42614c; border-radius: 50%; animation: media-upload-spin .8s linear infinite; }
.upload-tip { margin-top: 6rpx; color: #94a3b8; font-size: 17rpx; font-weight: 700; }
@keyframes media-upload-spin { to { transform: rotate(360deg); } }
.remove-media { position: absolute; top: 8rpx; right: 8rpx; z-index: 2; display: flex; align-items: center; justify-content: center; width: 44rpx; height: 44rpx; border-radius: 50%; background: #be123c; color: #fff; font-size: 28rpx; font-weight: 700; line-height: 1; }
.url-actions button { flex: 1; height: 76rpx; line-height: 76rpx; font-size: 22rpx; }
.field-label { display: block; margin: 30rpx 0 14rpx; color: #0f172a; font-size: 21rpx; font-weight: 900; letter-spacing: 1rpx; }
.breed-options { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; }
.breed-option { padding: 12rpx 20rpx; border: 1rpx solid #bbf7d0; border-radius: 999rpx; background: #f0fdf4; color: #166534; font-size: 21rpx; font-weight: 800; }
.gender-tabs { display: flex; gap: 8rpx; padding: 8rpx; border-radius: 20rpx; background: #f1f5f9; }
.gender-tab { flex: 1; padding: 22rpx 8rpx; border-radius: 16rpx; text-align: center; color: #64748b; font-size: 21rpx; font-weight: 800; }
.gender-tab.active { color: #0f172a; background: #fff; box-shadow: 0 6rpx 14rpx rgba(30,41,59,.08); }
.two-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.picker { padding: 26rpx 28rpx; border-radius: 24rpx; background: #f8fafc; border: 1rpx solid #e2e8f0; color: #334155; font-size: 23rpx; font-weight: 800; }
.lineage-section { margin-top: 30rpx; padding: 22rpx 24rpx 24rpx; border: 1rpx solid #edf0f4; border-radius: 26rpx; background: #fbfcfe; }
.lineage-head { display: flex; align-items: center; justify-content: space-between; }
.lineage-head .field-label { margin: 0; font-size: 19rpx; letter-spacing: 1.5rpx; }
.lineage-actions { display: flex; align-items: center; gap: 18rpx; }
.lineage-import { color: #2563eb; font-size: 20rpx; font-weight: 800; }
.lineage-reset { display: flex; align-items: center; justify-content: center; width: 34rpx; height: 34rpx; border-radius: 50%; color: #94a3b8; background: #eef2f7; font-size: 27rpx; line-height: 1; }
.lineage-fields { display: grid; grid-template-columns: 1fr 220rpx; gap: 14rpx; margin-top: 18rpx; }
.lineage-input { min-width: 0; height: 80rpx; min-height: 80rpx; padding: 0 18rpx; border: 1rpx solid #e2e8f0; border-radius: 18rpx; background: #fff; color: #1e293b; font-size: 22rpx; font-weight: 700; line-height: 80rpx; }
.lineage-ring { color: #475569; }
.textarea { width: 100%; min-height: 260rpx; padding: 24rpx; border: 1rpx solid #e2e8f0; border-radius: 24rpx; background: #f8fafc; color: #0f172a; font-size: 24rpx; font-weight: 700; }
.submit { width: calc(100% - 112rpx); height: 104rpx; line-height: 104rpx; margin: 0 56rpx; font-size: 27rpx; }
