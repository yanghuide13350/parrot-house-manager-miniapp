<view class="page fade-in form-page">
  <view class="page-pad safe-top form-head"><button class="back-button tap" bindtap="goBack" aria-label="返回"><app-icon name="arrow-left" size="22"/></button><view><view class="eyebrow">{{isEdit ? 'EDIT PROFILE' : (introductionMode ? 'NEW INTRODUCTION' : 'NEW PROFILE')}}</view><view class="title">{{isEdit ? '编辑档案' : (introductionMode ? '录入引种鸟' : '录入档案')}}</view></view></view>
  <view class="page-pad">
    <view class="card media-card">
      <view class="section-label">多媒体资产 · MEDIA</view>
      <view class="media-actions">
        <view class="media-action tap" data-kind="camera" bindtap="chooseMedia"><view class="media-icon gray">+</view><text>拍摄</text></view>
        <view class="media-action tap" data-kind="local" bindtap="chooseMedia"><view class="media-icon dashed">+</view><text>本地媒体</text></view>
        <view wx:for="{{media}}" wx:key="assetId" class="media-preview {{item.uploading ? 'media-uploading' : 'tap'}}" data-index="{{index}}" bindtap="previewMedia"><view wx:if="{{item.uploading}}" class="upload-placeholder"><view class="upload-spinner"></view><text>正在上传{{item.type === 'video' ? '视频' : '图片'}}</text><text class="upload-tip">请勿退出当前页面</text></view><block wx:else><image wx:if="{{item.type === 'image'}}" src="{{item.url}}" mode="aspectFill" lazy-load="true"/><view wx:else class="video-preview"><video class="video-thumb" src="{{item.url}}" object-fit="cover" controls="{{false}}" autoplay="{{false}}" muted="{{true}}" show-center-play-btn="{{false}}" show-play-btn="{{false}}" show-fullscreen-btn="{{false}}" direction="0" data-index="{{index}}" catchtap="previewMedia"/><view class="video-play" data-index="{{index}}" catchtap="previewMedia">▶</view></view><view class="remove-media tap" data-index="{{index}}" catchtap="removeMedia">×</view></block></view>
      </view>
    </view>
    <view class="card form-card">
      <text class="field-label">品种 · BREED</text><input class="input" data-key="breed" value="{{form.breed}}" bindinput="input" bindfocus="focusBreed" placeholder="如：玄凤、虎皮"/><view wx:if="{{breedOptions.length}}" class="breed-options"><text wx:for="{{breedOptions}}" wx:key="*this" class="breed-option tap" data-value="{{item}}" bindtap="chooseBreed">{{item}}</text></view>
      <text class="field-label">名称 · NAME</text><input class="input" data-key="species" value="{{form.species}}" bindinput="input" placeholder="如：黄化玄凤、原始灰玄凤"/>
      <text class="field-label">圈号 <text class="optional">（选填）</text></text><input class="input" data-key="ringNumber" value="{{form.ringNumber}}" bindinput="input" placeholder="暂未佩戴可留空，后续可补充"/>
      <text class="field-label">性别 · SEX</text><view class="gender-tabs"><text wx:for="{{genders}}" wx:key="key" data-key="{{item.key}}" bindtap="chooseGender" class="gender-tab {{form.gender === item.key ? 'active' : ''}}">{{item.label}}</text></view>
      <view class="two-fields"><view><text class="field-label">{{introductionMode ? '购买金额 (¥)' : '估值 (¥)'}}</text><input class="input" type="digit" data-key="price" value="{{form.price}}" bindinput="input" placeholder="0"/></view><view><text class="field-label">出生日期</text><picker mode="date" value="{{form.birthDate}}" bindchange="chooseDate"><view class="picker">{{form.birthDate}}</view></picker></view></view>
      <view wx:if="{{introductionMode}}"><text class="field-label">购买日期</text><picker mode="date" value="{{form.purchaseDate}}" bindchange="choosePurchaseDate"><view class="picker">{{form.purchaseDate}}</view></picker></view>
      <view class="lineage-section">
        <view class="lineage-head"><text class="field-label">父鸟血统 · FATHER</text><view class="lineage-actions"><picker range="{{maleCandidates}}" range-key="label" bindchange="chooseParent" data-role="father"><text class="lineage-import">从鸟库带入</text></picker><text wx:if="{{father}}" class="lineage-reset" data-role="father" bindtap="clearParent">×</text></view></view>
        <view class="lineage-fields"><input class="input lineage-input" data-role="father" data-key="species" data-focus="father-species" value="{{father ? father.species : ''}}" bindinput="inputManualParent" bindfocus="focusParentField" bindblur="blurParentField" placeholder="{{focusedParentField === 'father-species' ? '' : '父鸟品种'}}"/><input class="input lineage-input lineage-ring" data-role="father" data-key="ringNumber" data-focus="father-ring" value="{{father ? father.ringNumber : ''}}" bindinput="inputManualParent" bindfocus="focusParentField" bindblur="blurParentField" placeholder="{{focusedParentField === 'father-ring' ? '' : '圈号（选填）'}}"/></view>
      </view>
      <view class="lineage-section">
        <view class="lineage-head"><text class="field-label">母鸟血统 · MOTHER</text><view class="lineage-actions"><picker range="{{femaleCandidates}}" range-key="label" bindchange="chooseParent" data-role="mother"><text class="lineage-import">从鸟库带入</text></picker><text wx:if="{{mother}}" class="lineage-reset" data-role="mother" bindtap="clearParent">×</text></view></view>
        <view class="lineage-fields"><input class="input lineage-input" data-role="mother" data-key="species" data-focus="mother-species" value="{{mother ? mother.species : ''}}" bindinput="inputManualParent" bindfocus="focusParentField" bindblur="blurParentField" placeholder="{{focusedParentField === 'mother-species' ? '' : '母鸟品种'}}"/><input class="input lineage-input lineage-ring" data-role="mother" data-key="ringNumber" data-focus="mother-ring" value="{{mother ? mother.ringNumber : ''}}" bindinput="inputManualParent" bindfocus="focusParentField" bindblur="blurParentField" placeholder="{{focusedParentField === 'mother-ring' ? '' : '圈号（选填）'}}"/></view>
      </view>
      <text class="field-label">公开介绍 · PUBLIC PROFILE</text><textarea class="textarea" data-key="publicIntro" value="{{form.publicIntro}}" bindinput="input" placeholder="这部分内容会展示给买家..."/>
      <text class="field-label">内部备注 · PRIVATE NOTES</text><textarea class="textarea" data-key="privateNotes" value="{{form.privateNotes}}" bindinput="input" placeholder="记录健康、喂养、血统等内部信息..."/>
    </view>
    <button class="button-dark submit" disabled="{{saving || uploading}}" bindtap="save">{{uploading ? '正在处理媒体...' : (saving ? '正在提交数据...' : (isEdit ? '保存档案更新' : '确认录入系统'))}}</button>
  </view>
</view>
