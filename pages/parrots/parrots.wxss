.list-head { display:flex; align-items:flex-end; justify-content:space-between; padding-bottom:44rpx; }
.add-button { width:112rpx; height:112rpx; padding:0; border-radius:44rpx; background:#1e293b; color:#fff; font-size:56rpx; font-weight:300; }
.search-row { display:flex; align-items:center; gap:18rpx; }.search-box { position:relative; flex:1; border:1rpx solid #e2e8f0; border-radius:24rpx; background:#fff; }.search-box input { height:92rpx; padding:0 24rpx 0 72rpx; font-size:24rpx; font-weight:700; }.search-mark { position:absolute; left:24rpx; top:18rpx; color:#64748b; font-size:42rpx; }.filter-button { min-width:112rpx; height:92rpx; padding:0 22rpx; border:1rpx solid #e2e8f0; border-radius:24rpx; background:#fff; color:#64748b; font-size:22rpx; font-weight:900; }.filter-active { background:#1e293b; color:#fff; border-color:#1e293b; }.result-meta { padding-top:30rpx; color:#94a3b8; font-size:20rpx; font-weight:800; }
.parrot-grid { display:grid; grid-template-columns:1fr 1fr; gap:24rpx; padding-top:24rpx; }.parrot-card { overflow:hidden; border-radius:32rpx; }.parrot-image-wrap { position:relative; height:270rpx; overflow:hidden; background:#f1f5f9; }.parrot-image { width:100%; height:100%; }.parrot-image-wrap status-badge { position:absolute; left:18rpx; top:18rpx; }.parrot-content { padding:24rpx 22rpx 26rpx; }.parrot-name { overflow:hidden; color:#0f172a; font-size:25rpx; font-weight:900; text-overflow:ellipsis; white-space:nowrap; }.ring { margin-top:8rpx; overflow:hidden; color:#64748b; font-size:18rpx; font-weight:800; text-overflow:ellipsis; white-space:nowrap; }.age { margin-top:24rpx; color:#94a3b8; font-size:19rpx; font-weight:700; }.price { margin-top:20rpx; color:#0f172a; font-size:24rpx; font-weight:900; }
.overlay { position:fixed; inset:0; z-index:60; display:flex; align-items:flex-end; padding:28rpx; background:rgba(15,23,42,.62); }.long-menu { width:100%; padding:42rpx; border-radius:40rpx; }.long-title { color:#0f172a; font-size:34rpx; font-weight:900; }.long-ring { margin-top:10rpx; color:#64748b; font-size:22rpx; }.menu-button { width:100%; height:92rpx; margin-top:24rpx; font-size:26rpx; }.drawer { position:absolute; left:0; right:0; bottom:0; padding:44rpx 48rpx calc(48rpx + env(safe-area-inset-bottom)); border-radius:44rpx 44rpx 0 0; background:#fff; }.drawer-title { color:#0f172a; font-size:38rpx; font-weight:900; }.close { color:#94a3b8; font-size:48rpx; }.drawer-section { margin-top:36rpx; }.drawer-label { display:block; margin-bottom:16rpx; color:#64748b; font-size:20rpx; font-weight:900; letter-spacing:2rpx; }.choice-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:14rpx; }.choice { display:flex; align-items:center; justify-content:center; width:100%; height:88rpx; padding:0 12rpx; border:1rpx solid #e2e8f0; border-radius:24rpx; background:#f8fafc; color:#64748b; font-size:22rpx; font-weight:800; text-align:center; }.choice-active { color:#fff; background:#0f172a; border-color:#0f172a; }.price-inputs { display:grid; grid-template-columns:minmax(0,1fr) 28rpx minmax(0,1fr); align-items:center; gap:14rpx; }.price-inputs > text { color:#64748b; text-align:center; }.price-inputs .input { min-width:0; width:100%; height:88rpx; padding:0 22rpx; border-radius:24rpx; font-size:22rpx; }.drawer-actions { display:flex; gap:18rpx; margin-top:40rpx; }.drawer-actions button { flex:1; height:96rpx; font-size:25rpx; }
