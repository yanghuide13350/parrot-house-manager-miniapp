<page-meta page-style="{{drawer || longPressed ? 'overflow: hidden;' : ''}}" />
<view class="page fade-in">
  <view class="page-pad safe-top list-head"><view><view class="eyebrow">PARROT REGISTRY</view><view class="title">鹦鹉档案</view></view><button class="add-button tap" bindtap="addParrot"><app-icon name="plus" size="24"/></button></view>
  <view class="page-pad search-row">
    <view class="search-box"><app-icon class="search-mark" name="search" size="20"/><input value="{{search}}" bindinput="inputSearch" placeholder="搜索品种、圈号..."/></view>
    <button class="filter-button tap {{gender || status || filter || minPrice || maxPrice ? 'filter-active' : ''}}" bindtap="openDrawer">筛选</button>
    <button class="quick-reset tap" bindtap="quickReset">重置</button>
  </view>
  <view class="page-pad result-meta">{{filterLabel ? filterLabel + ' · ' : ''}}{{parrots.length}} 条档案</view>
  <view class="page-pad parrot-grid" wx:if="{{parrots.length}}"><view wx:for="{{parrots}}" wx:key="id" class="parrot-card card tap" data-id="{{item.id}}" bindtap="selectParrot" bindlongpress="startLongPress" bindtouchend="cancelLongPress" bindtouchmove="cancelLongPress"><view class="parrot-image-wrap"><image wx:if="{{item.coverType !== 'video'}}" class="parrot-image" src="{{item.image}}" mode="aspectFill" lazy-load="true"/><video wx:else class="parrot-video" src="{{item.videoUrl}}" object-fit="cover" controls="{{false}}" autoplay="{{false}}" muted="{{true}}" loop="{{false}}" show-center-play-btn="{{false}}" show-play-btn="{{false}}" show-fullscreen-btn="{{false}}" enable-progress-gesture="{{false}}"/><view wx:if="{{item.coverType === 'video'}}" class="video-cover-play">▶</view><status-badge status="{{item.status}}"/></view><view class="parrot-content"><view class="parrot-name">{{item.species}}</view><view class="ring">{{item.genderLabel}} · {{item.ringNumber}}</view><view class="between"><text class="age">{{item.age}}</text><text class="price">¥{{item.price}}</text></view></view></view></view>
  <empty-state wx:else title="暂无符合条件的档案" detail="调整筛选条件或录入新的鹦鹉"/>
  <view wx:if="{{longPressed}}" class="overlay" bindtap="closeLongPress"><view class="long-menu card" catchtap="noop"><view class="long-title">{{longPressed.species}}</view><view class="long-ring">{{longPressed.ringNumber}}</view><button class="button-dark menu-button" data-id="{{longPressed.id}}" bindtap="selectParrot">查看详情</button><button class="button-light menu-button" bindtap="shareLongPress">生成分享</button></view></view>
  <view wx:if="{{drawer}}" class="overlay" bindtap="closeDrawer"><view class="drawer" catchtap="noop"><view class="between"><text class="drawer-title">高级筛选</text><text class="close" bindtap="closeDrawer">×</text></view><view class="drawer-section"><text class="drawer-label">性别</text><view class="choice-grid gender-grid"><text wx:for="{{genders}}" wx:key="key" class="choice {{gender === item.key ? 'choice-active' : ''}}" data-key="{{item.key}}" bindtap="chooseGender">{{item.label}}</text></view></view><view class="drawer-section"><text class="drawer-label">状态</text><view class="choice-grid status-grid"><text wx:for="{{statuses}}" wx:key="key" class="choice {{status === item.key ? 'choice-active' : ''}}" data-key="{{item.key}}" bindtap="chooseStatus">{{item.label}}</text></view></view><view class="drawer-section"><text class="drawer-label">价格区间</text><view class="price-inputs"><input class="input" type="number" value="{{minPrice}}" bindinput="inputMin" placeholder="最低价"/><text>—</text><input class="input" type="number" value="{{maxPrice}}" bindinput="inputMax" placeholder="最高价"/></view></view><view class="drawer-actions"><button class="button-dark" bindtap="applyFilter">应用筛选</button></view></view></view>
</view>
