.invalid { min-height:100vh; display:flex; flex-direction:column; align-items:center; justify-content:center; background:#fff; color:#94a3b8; }.invalid-mark { width:112rpx; height:112rpx; line-height:112rpx; text-align:center; border-radius:50%; background:#fff1f2; color:#e11d48; font-size:56rpx; font-weight:900; }.invalid-title { margin-top:28rpx; color:#0f172a; font-size:34rpx; font-weight:900; }.invalid-detail { margin-top:14rpx; font-size:22rpx; }
.share-page { min-height:100vh; padding-bottom:80rpx; background:#fff; }.share-top { position:absolute; top:calc(48rpx + env(safe-area-inset-top)); left:44rpx; right:44rpx; z-index:10; display:flex; align-items:center; }.round-button { width:76rpx; height:76rpx; padding:0; border:1rpx solid rgba(226,232,240,.92); border-radius:24rpx; background:rgba(255,255,255,.96); }.mode { position:absolute; left:50%; top:50%; min-width:220rpx; padding:18rpx 26rpx; border-radius:26rpx; background:rgba(255,255,255,.9); color:#0f172a; font-size:21rpx; font-weight:900; text-align:center; transform:translate(-50%,-50%); }.share-media { height:820rpx; background:#0f172a; }.share-media image { width:100%; height:100%; }.media-dots { position:absolute; top:728rpx; left:0; right:0; z-index:6; display:flex; justify-content:center; gap:10rpx; }.media-dot { width:12rpx; height:12rpx; border-radius:999rpx; background:rgba(255,255,255,.5); }.media-dot.active { width:44rpx; background:#fff; }
.share-body { position:relative; margin:-120rpx 32rpx 0; padding:44rpx; border-radius:54rpx; background:#fff; box-shadow:0 24rpx 52rpx -16rpx rgba(30,41,59,.18); }.verified { color:#059669; font-size:20rpx; font-weight:900; letter-spacing:2rpx; }.identity { align-items:flex-end; margin-top:42rpx; }.share-title { color:#0f172a; font-size:42rpx; font-weight:900; }.share-ring { margin-top:10rpx; color:#64748b; font-size:22rpx; font-weight:800; }.share-price { text-align:right; }.share-price text { display:block; color:#64748b; font-size:19rpx; }.share-price strong { display:block; margin-top:8rpx; color:#0f172a; font-size:32rpx; }.share-grid { display:grid; grid-template-columns:1fr 1fr; gap:16rpx; margin-top:44rpx; }.share-grid view { padding:26rpx; border-radius:28rpx; text-align:center; background:#f8fafc; }.share-grid text { display:block; color:#64748b; font-size:20rpx; }.share-grid strong { display:block; margin-top:10rpx; color:#0f172a; font-size:25rpx; }.lineage-public { margin-top:44rpx; padding:28rpx; border-radius:28rpx; background:#f8fafc; }.public-row { display:flex; justify-content:space-between; gap:24rpx; margin-top:20rpx; color:#64748b; font-size:21rpx; }.public-row strong { color:#0f172a; text-align:right; font-size:22rpx; word-break:break-all; }.background { margin-top:44rpx; }.background text { display:block; margin-top:18rpx; color:#64748b; font-size:26rpx; line-height:1.7; font-weight:700; font-style:italic; }.powered { margin-top:52rpx; text-align:center; color:#94a3b8; font-size:18rpx; font-weight:800; letter-spacing:2rpx; }
