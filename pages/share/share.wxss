.invalid { min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #fff; color: #94a3b8; }.invalid-mark { width: 112rpx; height: 112rpx; line-height: 112rpx; text-align: center; border-radius: 50%; background: #fff1f2; color: #e11d48; font-size: 56rpx; font-weight: 900; }.invalid-title { margin-top: 28rpx; color: #0f172a; font-size: 34rpx; font-weight: 900; }.invalid-detail { margin-top: 14rpx; font-size: 22rpx; }.share-page { min-height: 100vh; padding-bottom: 80rpx; background: #fff; }.share-top { position: absolute; top: calc(48rpx + env(safe-area-inset-top)); left: 44rpx; right: 44rpx; z-index: 10; display: flex; justify-content: space-between; }.round-button { width: 88rpx; height: 88rpx; line-height: 82rpx; padding: 0; border-radius: 28rpx; font-size: 48rpx; }.round-button.dark { color: #fff; background: #0f172a; }.mode { padding: 20rpx 26rpx; border-radius: 30rpx; background: rgba(255,255,255,.88); color: #0f172a; font-size: 20rpx; font-weight: 900; }.share-media { height: 820rpx; background: #0f172a; }.share-media image, .share-media video { width: 100%; height: 100%; }.share-body { position: relative; margin: -120rpx 32rpx 0; padding: 44rpx; border-radius: 54rpx; background: #fff; box-shadow: 0 24rpx 52rpx -16rpx rgba(30,41,59,.18); }.verified { color: #059669; font-size: 20rpx; font-weight: 900; letter-spacing: 2rpx; }.identity { align-items: flex-end; margin-top: 42rpx; }.share-title { color: #0f172a; font-size: 42rpx; font-weight: 900; }.share-ring { margin-top: 10rpx; color: #64748b; font-size: 22rpx; font-weight: 800; }.share-price { text-align: right; }.share-price text { display: block; color: #64748b; font-size: 19rpx; }.share-price strong { display: block; margin-top: 8rpx; color: #0f172a; font-size: 32rpx; }.share-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-top: 44rpx; }.share-grid view { padding: 26rpx; border-radius: 28rpx; text-align: center; background: #f