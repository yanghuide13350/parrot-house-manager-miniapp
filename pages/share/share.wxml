<view wx:if="{{invalid}}" class="invalid"><view class="invalid-mark">!</view><view class="invalid-title">分享已失效</view><view class="invalid-detail">该档案链接已过期或被撤销</view></view><view wx:elif="{{parrot}}" class="share-page"><view class="share-top"><button class="round-button dark tap" bindtap="goBack">‹</button><view class="mode">买家视角预览</view></view><swiper class="share-media" current="{{activeIndex}}" bindchange="swiperChange"><swiper-item wx:for="{{media}}" wx:key="url"><image wx:if="{{item.type === 'image'}}" src="{{item.url}}" mode="aspectFill"/><video wx:else src="{{item.url}}" poster="{{item.poster}}" controls="true" object-fit="cover"/></swiper-item></swiper><view class="share-body"><view class="verified">✓ 官方认证档案 · VERIFIED</view><view class="between identity"><view><view class="share-title">{{parrot.species}}</view><view class="share-ring">ID: {{parrot.ringNumber}}</view></view><view class="share-price"><text>价格咨询</text><strong>¥{{parrot.price}}</strong></view></view><view class="share-grid"><view><text>性别</text><strong>{{parrot.gender}}</strong></view><view><text>月龄</text><strong>{{parrot.age}}</strong></view><view><text>健康状态</text><strong>极佳</strong></view><view><text>品种稀有度</text><strong>五星</strong></view></view><view class="background"><view class="section-label">种群描述 · BACKGROUND</view><text>“{{parrot.desc || '暂无描述，这是一只非常优秀的成员。'}}”</text></view></view><view class="powered">Powered by ParrotPro · 高级养殖数字化平台</view></view>
