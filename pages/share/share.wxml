<view wx:if="{{invalid}}" class="invalid"><view class="invalid-mark">!</view><view class="invalid-title">分享已失效</view><view class="invalid-detail">该档案链接已过期或被撤销</view></view><view wx:elif="{{parrot}}" class="share-page"><view class="share-top" style="{{shareTopStyle}}"><button class="round-button tap" bindtap="goBack"><app-icon name="arrow-left" size="22"/></button><view class="mode">买家视角预览</view></view><swiper class="share-media" current="{{activeIndex}}" bindchange="swiperChange" circular="{{media.length > 1}}"><swiper-item wx:for="{{media}}" wx:key="url"><image src="{{item.url}}" mode="aspectFill" lazy-load="true"/></swiper-item></swiper><view class="media-dots" wx:if="{{media.length > 1}}"><view wx:for="{{media}}" wx:key="url" class="media-dot {{activeIndex === index ? 'active' : ''}}"></view></view><view class="share-body"><view class="verified">✓ 血统档案 · VERIFIED</view><view class="between identity"><view><view class="share-title">{{parrot.species}}</view><view class="share-ring">ID: {{parrot.ringNumber}}</view></view><view class="share-price"><text>价格咨询</text><strong>¥{{parrot.price}}</strong></view></view><view class="share-grid"><view><text>性别</text><strong>{{parrot.gender}}</strong></view><view><text>月龄</text><strong>{{parrot.age}}</strong></view><view><text>档案编号</text><strong>{{parrot.ringNumber}}</strong></view><view><text>公开报价</text><strong>¥{{parrot.price}}</strong></view></view><view class="lineage-public"><view class="section-label">血统与出生 · LINEAGE</view><view class="public-row"><text>出生日期</text><strong>{{parrot.birthDateLabel}}</strong></view><view class="public-row"><text>父鸟</text><strong>{{parrot.fatherLabel}}</strong></view><view class="public-row"><text>母鸟</text><strong>{{parrot.motherLabel}}</strong></view><view wx:if="{{parrot.clutchLabel}}" class="public-row"><text>来源窝次</text><strong>{{parrot.clutchLabel}}</strong></view></view><view class="background"><view class="section-label">档案介绍 · BACKGROUND</view><text>“{{parrot.desc || '暂无描述，这是一只优秀的鹦鹉。'}}”</text></view></view><view class="powered">Powered by ParrotPro · 高级养殖数字化平台</view></view>
