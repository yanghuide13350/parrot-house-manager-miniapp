.editor-page { display: flex; flex-direction: column; height: 100vh; overflow: hidden; background: #fdfbf9; }.editor-head { display: flex; align-items: center; gap: 22rpx; padding-right: 56rpx; padding-bottom: 48rpx; padding-left: 56rpx; background: #fdfbf9; }.editor-head > view { flex: 1; }.stepper { display: flex; align-items: center; justify-content: space-between; margin: 0 56rpx; padding: 18rpx 0 26rpx; border-top: 1rpx solid #ebe7df; color: #8a919b; font-size: 20rpx; font-weight: 800; }.progress-dots { display: flex; gap: 12rpx; }.step-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: #d8dce0; }.step-dot.active { background: #17243b; }
.editor-body { height: 0; flex: 1; }.form-section { padding: 28rpx 56rpx 50rpx; }.section-caption { display: none; }.section-title { margin-top: 0; color: #17243b; font-size: 30rpx; font-weight: 900; }.section-copy { margin-top: 10rpx; color: #8a919b; font-size: 21rpx; line-height: 1.5; }.field-card, .note-card { box-sizing: border-box; margin-top: 20rpx; padding: 20rpx 24rpx; border: 1rpx solid #e5e1d9; border-radius: 24rpx; background: #fff; }.field-card text, .note-card text { display: block; color: #697687; font-size: 19rpx; font-weight: 900; }.field-card input { height: 48rpx; margin-top: 9rpx; color: #1d2a40; font-size: 25rpx; font-weight: 800; }.split-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }.split-fields .field-card { min-width: 0; }.note-card textarea { display: block; box-sizing: border-box; width: 100%; min-height: 116rpx; margin-top: 12rpx; color: #1d2a40; font-size: 23rpx; line-height: 1.55; }.delete-plan { display: block; margin: 34rpx auto 0; padding: 12rpx 22rpx; background: transparent; color: #b24c57; font-size: 21rpx; font-weight: 800; }
.feeding-types { display: grid; grid-template-columns: 1fr; gap: 14rpx; margin-top: 24rpx; }.feeding-type { padding: 22rpx 24rpx; border: 1rpx solid #e5e1d9; border-radius: 22rpx; background: #fff; color: #536172; }.feeding-type text { display: block; color: #1d2a40; font-size: 24rpx; font-weight: 900; }.feeding-type view { margin-top: 6rpx; font-size: 19rpx; font-weight: 700; }.feeding-type.selected { border-color: #17243b; background: #17243b; color: #c9d2dd; }.feeding-type.selected text { color: #fff; }.food-block { margin-top: 34rpx; }.food-block-title { color: #17243b; font-size: 24rpx; font-weight: 900; }
.breed-options { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }.breed-option { padding: 10rpx 18rpx; border-radius: 16rpx; background: #f1f3f0; color: #405168; font-size: 20rpx; font-weight: 800; }.age-card { margin-top: 20rpx; padding: 22rpx 24rpx 24rpx; border: 1rpx solid #e5e1d9; border-radius: 24rpx; background: #fff; }.age-card-head { display: flex; justify-content: space-between; color: #697687; font-size: 19rpx; font-weight: 900; }.age-card-head text:last-child { color: #a0a6ae; font-size: 18rpx; font-weight: 700; }.age-range { display: flex; align-items: center; gap: 14rpx; margin-top: 18rpx; }.age-point { min-width: 0; flex: 1; }.age-point > text { display: block; color: #8a919b; font-size: 18rpx; font-weight: 800; }.age-inputs { display: flex; align-items: center; gap: 6rpx; margin-top: 8rpx; }.age-inputs input { min-width: 0; width: 46rpx; height: 42rpx; border-bottom: 2rpx solid #d7dcd7; color: #17243b; font-size: 27rpx; font-weight: 900; text-align: center; }.age-inputs text { color: #627084; font-size: 19rpx; font-weight: 800; }.age-arrow { flex: 0 0 34rpx; color: #a1a8ae; font-size: 30rpx; text-align: center; }
.form-footer { display: flex; gap: 18rpx; padding: 20rpx 56rpx calc(22rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e9e5dc; background: #fffdfa; }.previous, .next { height: 88rpx; border-radius: 24rpx; font-size: 24rpx; font-weight: 900; }.previous { flex: 0 0 150rpx; border: 1rpx solid #d5d8d4; background: #fff; color: #425166; }.next { flex: 1; }
.editor-page { min-height: 0 !important; padding-bottom: 0 !important; }.form-footer { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
