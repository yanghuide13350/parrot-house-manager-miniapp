<page-meta page-style="{{showPairing || showSale || showProgress || showFeedingPlan || showSaleCopy ? 'overflow: hidden;' : ''}}" />
<view class="page fade-in detail" wx:if="{{parrot}}">
  <view class="detail-top" style="{{detailTopStyle}}">
    <button class="round-button tap" bindtap="goBack" aria-label="返回"><app-icon name="arrow-left" size="22"/></button>
    <view class="detail-actions" style="{{detailActionsStyle}}">
      <button wx:if="{{shareToken}}" class="round-button tap" open-type="share" aria-label="转发分享"><app-icon name="share" size="20"/></button>
      <button wx:if="{{feedingPlan}}" class="round-button feeding-plan-button tap" bindtap="openFeedingPlan" aria-label="查看喂养方案"><app-icon name="bottle" size="20" alt="喂养方案"/></button>
      <button class="round-button dark tap" bindtap="edit" aria-label="编辑"><app-icon name="pencil" size="20"/></button>
      <button class="round-button danger-button tap" disabled="{{submitting}}" bindtap="remove" aria-label="删除"><app-icon name="trash" size="20"/></button>
    </view>
  </view>

  <swiper class="media-swiper" current="{{activeIndex}}" bindchange="swiperChange" circular="false">
    <swiper-item wx:for="{{media}}" wx:key="url">
      <view class="media-item tap" data-index="{{index}}" bindtap="openMedia">
        <image class="media-image" src="{{item.url}}" mode="aspectFill" lazy-load="true"/>
        <view class="media-hint media-hint-image">点击查看大图</view>
      </view>
    </swiper-item>
  </swiper>
  <view class="media-dots" wx:if="{{media.length > 1}}"><view wx:for="{{media}}" wx:key="url" class="media-dot {{activeIndex === index ? 'active' : ''}}"></view></view>

  <view class="page-pad detail-body">
    <view class="card identity-card">
      <view class="between"><view><view class="profile-title">{{parrot.species}}</view><view class="profile-ring">{{parrot.breed ? '品种：' + parrot.breed + ' · ' : ''}}脚环：{{parrot.ringLabel}}</view></view><status-badge status="{{parrot.status}}" label-override="{{statusLabel}}"/></view>
      <view class="detail-grid"><view><text>性别</text><strong>{{genderLabel}}</strong></view><view><text>年龄</text><strong>{{parrot.age}}</strong></view><view><text>健康</text><strong>优秀</strong></view><view><text>估值</text><strong>¥{{parrot.price}}</strong></view></view>
      <view wx:if="{{parrot.privateNotes}}" class="observation"><view class="section-label">内部备注</view><text>{{parrot.privateNotes}}</text></view>
      <view wx:if="{{parrot.isIntroduction}}" class="observation"><view class="section-label">引种信息</view><text>购买日期：{{parrot.purchaseDate}} · 购入金额：¥{{parrot.price}}</text></view>
    </view>

    <view class="card relations-card">
      <view class="section-heading"><view><view class="section-label">关系与血统</view><text>RELATIONSHIPS & LINEAGE</text></view></view>
      <view wx:if="{{parrot.mate}}" class="mate-row {{parrot.mateId ? 'tap' : ''}}" data-id="{{parrot.mateId}}" bindtap="viewRelatedParrot"><view><text>当前配偶</text><strong>{{parrot.mate}}</strong></view><text wx:if="{{parrot.mateId}}" class="chevron">›</text></view>
      <view class="lineage-grid"><view class="lineage-item {{parrot.father && parrot.father.id ? 'tap' : ''}}" data-id="{{parrot.father && parrot.father.id ? parrot.father.id : ''}}" bindtap="viewRelatedParrot"><text>父鸟</text><strong>{{parrot.father ? parrot.father.species + (parrot.father.ringNumber ? '｜' + parrot.father.ringNumber : '') : '暂未录入'}}</strong><text wx:if="{{parrot.father && parrot.father.id}}" class="lineage-link">查看 ›</text></view><view class="lineage-item {{parrot.mother && parrot.mother.id ? 'tap' : ''}}" data-id="{{parrot.mother && parrot.mother.id ? parrot.mother.id : ''}}" bindtap="viewRelatedParrot"><text>母鸟</text><strong>{{parrot.mother ? parrot.mother.species + (parrot.mother.ringNumber ? '｜' + parrot.mother.ringNumber : '') : '暂未录入'}}</strong><text wx:if="{{parrot.mother && parrot.mother.id}}" class="lineage-link">查看 ›</text></view></view>
    </view>

    <view class="card breeding-history-card"><view class="between history-heading"><view><view class="section-label">繁育记录</view><text>CLUTCH HISTORY · 共{{clutchTotal}}窝</text></view><text wx:if="{{clutchTotal > 2}}" class="history-toggle tap" bindtap="toggleClutches">{{showAllClutches ? '收起' : '查看全部'}}</text></view><view wx:if="{{visibleClutches.length}}"><view wx:for="{{visibleClutches}}" wx:key="id" class="clutch-row tap" data-id="{{item.id}}" data-no="{{item.clutchNo}}" bindtap="viewClutchParrots"><view class="clutch-top"><strong>第{{item.clutchNo}}窝</strong><text>{{item.hatched}} / {{item.eggs}}只出壳</text></view><view class="clutch-detail"><text>配偶：{{item.partnerText}} · 孵化：{{item.startDate}}</text></view><view class="clutch-birds"><view><text>已录入 {{item.offspringRegistered || 0}} 只幼鸟</text><text>脚环：{{item.offspringRingText}}</text></view><text class="clutch-chevron">›</text></view><button wx:if="{{item.canIntake}}" class="clutch-intake" data-id="{{item.id}}" catchtap="intakeChicks">{{item.intakeLabel}}</button><text wx:elif="{{item.hatched > 0 && item.offspringRegistered}}" class="clutch-intake-done">{{item.intakeLabel}}</text></view></view><text wx:else class="empty-clutch">暂无出窝记录</text></view>
    <view class="action-grid">
      <button wx:if="{{parrot.canSell}}" class="button-dark full ai-sale-copy-button" disabled="{{saleCopyLoading}}" bindtap="openSaleCopy"><text>{{saleCopyStatus ? (saleCopyStatus.status === 'READY' ? '查看 AI 售卖文案' : (saleCopyStatus.status === 'FAILED' ? '重新生成 AI 售卖文案' : 'AI 售卖文案生成中')) : 'AI 生成售卖文案'}}</text><text wx:if="{{saleCopyStatus && saleCopyStatus.unread}}" class="sale-copy-unread">●</text></button>
      <button wx:if="{{parrot.status === 'FOR_SALE'}}" class="button-light" disabled="{{submitting}}" bindtap="setBreeder">设置种鸟</button>
      <button wx:if="{{parrot.isIntroduction && parrot.status === 'FOR_SALE' && parrot.introductionStage === 'GROWING'}}" class="button-light" disabled="{{submitting}}" bindtap="markForSale">转为待售</button>
      <button wx:if="{{parrot.canSell}}" class="button-dark" disabled="{{submitting}}" bindtap="openSale">确认售出</button>
      <button wx:if="{{parrot.status === 'BREEDER'}}" class="button-dark" disabled="{{submitting}}" bindtap="openPairing">开始配对</button>
      <button wx:if="{{parrot.status === 'BREEDER'}}" class="button-light danger" disabled="{{submitting}}" bindtap="removeBreeder">去除种鸟</button>
      <button wx:if="{{parrot.status === 'PAIRED'}}" class="button-dark full progress-button" bindtap="openProgress">推进孵化</button>
      <button wx:if="{{parrot.status === 'INCUBATING'}}" class="button-dark full" bindtap="viewHatching">查看详细孵化动态</button>
    </view>

    <view class="share-entry card">
      <view class="share-main">
        <view class="section-label">SHARE PROFILE</view>
        <text>{{shareToken ? '已生成公开链接，顶部按钮可直接分享给微信好友' : '生成 7 天有效的公开分享链接'}}</text>
      </view>
      <button wx:if="{{!shareToken}}" class="button-dark share-primary" disabled="{{submitting}}" bindtap="generateShare">{{submitting ? '生成中...' : '生成分享链接'}}</button>
      <view wx:if="{{shareToken}}" class="share-link-box tap" bindtap="previewShare">
        <text class="share-link">{{shareUrl}}</text>
      </view>
      <view wx:if="{{shareToken}}" class="share-hint between">
        <text>{{shareExpiryLabel}}</text>
        <text>点击链接卡片可预览</text>
      </view>
      <view wx:if="{{shareToken}}" class="share-actions">
        <button class="button-light share-secondary" bindtap="copyShareLink">复制链接</button>
        <button class="button-light share-secondary" bindtap="previewShare">查看预览</button>
        <button class="share-revoke" disabled="{{submitting}}" bindtap="revokeShare">撤销链接</button>
      </view>
    </view>
  </view>

  <view wx:if="{{showPairing}}" class="overlay" bindtap="closePairing"><view class="modal card" catchtap="noop"><view class="between"><text class="modal-title">选择配偶</text><text class="close" bindtap="closePairing">×</text></view><view wx:if="{{eligible.length}}" class="mate-list"><view wx:for="{{eligible}}" wx:key="id" class="mate-item {{selectedMate === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="chooseMate"><image src="{{item.image}}" mode="aspectFill"/><view><view>{{item.species}}</view><text>{{item.genderLabel}} · {{item.ringNumber}}</text></view></view></view><view wx:else class="empty-note">暂无符合条件的异性种鸟</view><button class="button-dark modal-submit" disabled="{{submitting}}" bindtap="confirmPairing">{{submitting ? '正在配对...' : '确认配对'}}</button></view></view>
  <view wx:if="{{showSale}}" class="overlay" bindtap="closeSale"><view class="modal card" catchtap="noop"><view class="between"><text class="modal-title">确认交易售出</text><text class="close" bindtap="closeSale">×</text></view><text class="field-label">买家姓名</text><input class="input" data-key="buyer" value="{{buyer}}" bindinput="inputSale" placeholder="请输入买家称呼"/><text class="field-label">成交金额</text><input class="input" type="number" data-key="price" value="{{price}}" bindinput="inputSale" placeholder="请输入实付金额"/><text class="field-label">联系方式</text><input class="input" data-key="contact" value="{{contact}}" bindinput="inputSale" placeholder="输入手机号或微信"/><button class="button-dark modal-submit" disabled="{{submitting}}" bindtap="confirmSale">{{submitting ? '正在提交...' : '确认并封存档案'}}</button></view></view>
  <view wx:if="{{showSaleCopy}}" class="overlay" bindtap="closeSaleCopy"><view class="modal card sale-copy-modal" catchtap="noop"><view class="sale-copy-head between"><view><text class="modal-title">AI 售卖文案</text><text class="sale-copy-subtitle">选风格，补充真实情况，生成更像你说的话</text></view><text class="close" bindtap="closeSaleCopy">×</text></view><scroll-view wx:if="{{!saleCopyPending}}" scroll-y show-scrollbar="{{false}}" class="sale-copy-body"><scroll-view wx:if="{{!saleCopyPending}}" scroll-x scroll-with-animation class="sale-copy-style-rail"><view class="sale-copy-style-track"><view wx:for="{{saleCopyStyles}}" wx:key="key" class="sale-copy-style-card {{saleCopyStyle === item.key ? 'selected' : ''}}" data-style="{{item.key}}" bindtap="chooseSaleCopyStyle"><text>{{item.label}}</text><small>{{item.description}}</small></view></view></scroll-view><view wx:if="{{showSaleCopyOptions}}" class="sale-copy-options"><view wx:for="{{saleCopyTraitGroups}}" wx:for-item="group" wx:key="key" class="sale-copy-trait-row"><text class="sale-copy-trait-label">{{group.label}}</text><view class="sale-copy-trait-options"><text wx:for="{{group.options}}" wx:for-item="option" wx:key="key" class="sale-copy-trait {{saleCopyTraits[group.key] === option.key ? 'selected' : ''}}" data-group="{{group.key}}" data-value="{{option.key}}" bindtap="chooseSaleCopyTrait">{{option.label}}</text></view></view><textarea class="textarea sale-copy-note" value="{{saleCopyNote}}" maxlength="300" placeholder="补充备注（选填），如可预约、刚断奶" bindinput="inputSaleCopyNote"/></view><view wx:if="{{saleCopyLoading}}" class="sale-copy-loading"><text>正在提交后台任务…</text></view><view wx:if="{{saleCopy}}" class="sale-copy-result"><view class="sale-copy-result-label">标题</view><text class="sale-copy-title">{{saleCopy.title}}</text><view class="sale-copy-result-label">正文</view><text class="sale-copy-content">{{saleCopy.content}}</text></view></scroll-view><view wx:if="{{saleCopyPending}}" class="sale-copy-pending-empty"><view class="sale-copy-generator"><view class="sale-copy-generator-halo sale-copy-generator-halo-one"></view><view class="sale-copy-generator-halo sale-copy-generator-halo-two"></view><view class="sale-copy-generator-orbit"><view class="sale-copy-generator-dot"></view></view><view class="sale-copy-generator-core"><text>AI</text></view><text class="sale-copy-generator-title">文案生成中</text></view></view><view class="sale-copy-actions"><button wx:if="{{saleCopyPending}}" class="button-light sale-copy-secondary" bindtap="closeSaleCopy">先去忙</button><button wx:if="{{saleCopy}}" class="button-light sale-copy-secondary" bindtap="toggleSaleCopyOptions">{{showSaleCopyOptions ? '收起条件' : '调整信息'}}</button><button wx:if="{{saleCopy}}" class="button-light sale-copy-secondary" disabled="{{saleCopyLoading}}" bindtap="generateSaleCopy">换一版</button><button wx:if="{{!saleCopy && !saleCopyPending}}" class="button-dark modal-submit" disabled="{{saleCopyLoading}}" bindtap="generateSaleCopy">{{saleCopyLoading ? '提交中…' : '生成售卖文案'}}</button><button wx:if="{{saleCopy}}" class="button-dark sale-copy-primary" bindtap="copySaleCopy">复制全文</button></view></view></view>
  <view wx:if="{{showSaleCopy && saleCopyStreamText}}" class="sale-copy-live" catchtap="noop"><view class="sale-copy-live-card"><view class="between"><text class="modal-title">AI 正在写文案</text><text class="close" bindtap="closeSaleCopy">×</text></view><text class="sale-copy-live-text">{{saleCopyStreamText}}<text class="sale-copy-cursor">▍</text></text><button class="button-light sale-copy-secondary" bindtap="closeSaleCopy">先去忙</button></view></view>
  <view wx:if="{{showProgress}}" class="overlay" bindtap="closeProgress"><view class="modal card" catchtap="noop"><view class="between"><text class="modal-title">推进繁育任务</text><text class="close" bindtap="closeProgress">×</text></view><text class="field-label">蛋数量</text><input class="input" type="number" value="{{eggCount}}" bindinput="inputEgg"/><button class="button-dark modal-submit" disabled="{{submitting}}" bindtap="startProgress">{{submitting ? '正在启动...' : '确认启动'}}</button></view></view>
  <view wx:if="{{showFeedingPlan}}" class="overlay" bindtap="closeFeedingPlan"><scroll-view scroll-y class="modal card feeding-modal" catchtap="noop"><view class="between"><text class="modal-title">{{feedingPlan.name}}</text><text class="close" bindtap="closeFeedingPlan">×</text></view><view class="guide"><text>适用：{{feedingPlan.species}} · {{feedingPlan.stage}} · {{feedingPlan.ageFromMonths}}月{{feedingPlan.ageFromDays || 0}}天–{{feedingPlan.ageToMonths}}月{{feedingPlan.ageToDays || 0}}天</text><text>食物：{{feedingPlan.feedingType === 'MIXED' ? '奶粉 + 谷子' : feedingPlan.feedingType === 'SOLID' ? '谷子 / 固体食物' : '奶粉'}}</text><text>每日：{{feedingPlan.feedingsPerDay || '—'}} 次 · 单次：{{feedingPlan.amountMl || '未填写'}}</text><text wx:if="{{feedingPlan.feedingType !== 'SOLID'}}">奶粉：{{feedingPlan.formulaName || '未填写'}}</text><text wx:if="{{feedingPlan.feedingType !== 'SOLID'}}">配比：{{feedingPlan.waterMl || '—'}}ml 水 + {{feedingPlan.powderScoops || '—'}}</text><text wx:if="{{feedingPlan.feedingType !== 'SOLID'}}">水温：{{feedingPlan.temperatureMin}}–{{feedingPlan.temperatureMax}}℃</text><text wx:if="{{feedingPlan.feedingType !== 'FORMULA'}}">谷子/固体食物：{{feedingPlan.seedFoodName || '未填写'}} · {{feedingPlan.seedFoodAmount || '未填写'}}</text><text>方式：{{feedingPlan.feedingMethod || '未填写'}}</text></view><view wx:if="{{feedingPlan.feedingType !== 'SOLID'}}" class="guide-section"><strong>水温判断</strong><text>{{feedingPlan.temperatureCheck || '未填写'}}</text></view><view wx:if="{{feedingPlan.feedingType !== 'FORMULA'}}" class="guide-section"><strong>谷子/固体食物说明</strong><text>{{feedingPlan.seedFoodNotes || '未填写'}}</text></view><view class="guide-section"><strong>操作与注意</strong><text>{{feedingPlan.feedingNotes || '未填写'}}</text></view><view class="guide-section"><strong>喂饱判断</strong><text>{{feedingPlan.fullnessNotes || '未填写'}}</text></view><view class="guide-section"><strong>异常提醒</strong><text>{{feedingPlan.warningNotes || '未填写'}}</text></view><button class="button-dark modal-submit" bindtap="copyFeedingGuide">复制给买家</button></scroll-view></view>
</view>
