.media-video-pending { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16rpx; color: #fff; font-size: 30rpx; font-weight: 900; }.media-video-pending text:last-child { color: #94a3b8; font-size: 20rpx; font-weight: 700; }
