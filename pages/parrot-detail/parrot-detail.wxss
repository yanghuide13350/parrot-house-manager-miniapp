.detail-top { position: absolute; top: calc(48rpx + env(safe-area-inset-top)); left: 44rpx; right: 44rpx; z-index: 10; display: flex; justify-content: space-between; }.detail-actions { display: flex; gap: 18rpx; }.round-button { width: 88rpx; height: 88rpx; line-height: 82rpx; padding: 0; border: 1rpx solid #e2e8f0; border-radius: 28rpx; background: rgba(255,255,255,.9); color: #0f172a; font-size: 46rpx; font-weight: 300; }.round-button.dark { background: #0f172a; color: #fff; border-color: #0f172a; }.danger-button { color: #e11d48; background: #fff1f2; border-color: #fecdd3; }.media-swiper { height: 760rpx; background: #0f172a; }.media-item, .media-item image, .media-item video { width: 100%; height: 100%; }.media-dots { position: absolute; top: 680rpx; left: 0; right: 0; display: flex; justify-content: center; gap: 10rpx; z-index: 5; }.media-dot { width: 12rpx; height: 12rpx; border-radius: 12rpx; background: #cbd5e1; opacity: .8; }.media-dot.active { width: 48rpx; background: #0f172a; }.detail-body { position: relative; z-index: 3; margin-top: -100rpx; }.profile-card { padding: 42rpx; border-radius: 48rpx; }.profile-title { color: #0f172a; font-size: 42rpx; font-weight: 900; }.profile-ring { margin-top: 10rpx; color: #64748b; font-size: 22rpx; font-weight: 800; }.detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 44rpx; }.detail-grid view { padding: 26rpx; border-radius: 28rpx; background: #f8fafc; }.detail-grid text { display: block; color: #64748b; font-size: 20rpx; }.detail-grid strong { display: block; margin-top: 10rpx; color: #0f172a; font-size: 26rpx; }.observation, .mate { margin-top: 42rpx; }.section-label { color: #0f172a; font-size: 20rpx; font-weight: 900; letter-spacing: 2rpx; }.observation text, .mate text { display: block; margin-top: 18rpx; color: #64748b; font-size: 26rpx; line-height: 1.7; font-weight: 700; }.action-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 28rpx; }.action-grid button { height: 104rpx; line-height: 104rpx; font-size: 25rpx; }.action-grid .full { grid-column: 1 / 3; }.danger { color: #e11d48; }.share-entry { display: flex; align-items: center; justify-content: space-between; padding: 34rpx 40rpx; margin-top: 28rpx; }.share-entry text:last-child { display: block; margin-top: 10rpx; color: #64748b; font-size: 22rpx; font-weight: 800; }.share-main { flex: 1; min-width: 0; }.revoke-share { flex: 0 0 96rpx; width: 96rpx; height: 64rpx; margin: 0; padding: 0; border-radius: 18rpx; color: #be123c; background: #fff1f2; font-size: 20rpx; font-weight: 900; line-height: 64rpx; }.chevron { color: #cbd5e1; font-size: 52rpx; }.overlay { position: fixed; inset: 0; z-index: 60; display: flex; align-items: flex-end; padding: 28rpx; background: rgba(15,23,42,.68); }.modal { width: 100%; max-height: 88vh; overflow-y: auto; padding: 44rpx; border-radius: 40rpx; }.modal-title { color: #0f172a; font-size: 36rpx; font-weight: 900; }.close { color: #94a3b8; font-size: 48rpx; }.mate-list { margin-top: 32rpx; }.mate-item { display: flex; align-items: center; gap: 22rpx; padding: 20rpx; border: 2rpx solid #eef1f4; border-radius: 24rpx; margin-bottom: 16rpx; color: #0f172a; font-size: 25rpx; font-weight: 800; }.mate-item.selected { border-color: #0f172a; background: #f8fafc; }.mate-item image { width: 88rpx; height: 88rpx; border-radius: 24rpx; }.mate-item text { display: block; margin-top: 6rpx; color: #64748b; font-size: 20rpx; }.empty-note { padding: 50rpx 0; text-align: center; color: #94a3b8; font-weight: 800; }.field-label { display: block; margin: 28rpx 0 14rpx; color: #64748b; font-size: 22rpx; font-weight: 800; }.modal-submit { width: 100%; height: 92rpx; line-height: 92rpx; margin-top: 34rpx; font-size: 25rpx; }
