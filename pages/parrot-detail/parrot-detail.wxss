.detail-top { position: absolute; top: calc(48rpx + env(safe-area-inset-top)); left: 44rpx; right: 44rpx; z-index: 10; display: flex; align-items: center; justify-content: space-between; }.detail-actions { display: flex; align-items: center; gap: 18rpx; }.round-button { width: 88rpx; height: 88rpx; line-height: 82rpx; padding: 0; border: 1rpx solid #e2e8f0; border-radius: 28rpx; background: rgba(255,255,255,.94); color: #0f172a; font-size: 46rpx; font-weight: 300; }.round-button.dark { background: #0f172a; color: #fff; border-color: #0f172a; }.danger-button { color: #e11d48; background: #fff1f2; border-color: #fecdd3; }.media-swiper { height: 760rpx; background: #1e293b; }.media-item { position: relative; width: 100%; height: 100%; overflow: hidden; background: #1e293b; }.media-image, .media-video { width: 100%; height: 100%; }.media-video { background: #1e293b; }.media-hint { position: absolute; left: 50%; bottom: 34rpx; z-index: 2; transform: translateX(-50%); padding: 12rpx 22rpx; border-radius: 24rpx; color: #fff; background: rgba(15,23,42,.62); font-size: 20rpx; font-weight: 800; }.media-hint-image { bottom: 24rpx; }.video-frame-hint { bottom: 34rpx; background: rgba(15,23,42,.72); }.media-dots { position: absolute; top: 680rpx; left: 0; right: 0; display: flex; justify-content: center; gap: 10rpx; z-index: 5; }.media-dot { width: 12rpx; height: 12rpx; border-radius: 12rpx; background: #cbd5e1; opacity: .8; }.media-dot.active { width: 48rpx; background: #0f172a; }.detail-body { position: relative; z-index: 3; margin-top: -100rpx; }.profile-card { padding: 42rpx; border-radius: 48rpx; }.profile-title { color: #0f172a; font-size: 42rpx; font-weight: 900; }.profile-ring { margin-top: 10rpx; color: #64748b; font-size: 22rpx; font-weight: 800; }.detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 44rpx; }.detail-grid view { padding: 26rpx; border-radius: 28rpx; background: #f8fafc; }.detail-grid text { display: block; color: #64748b; font-size: 20rpx; }.detail-grid strong { display: block; margin-top: 10rpx; color: #0f172a; font-size: 26rpx; }.observation, .mate { margin-top: 42rpx; }.section-label { color: #0f172a; font-size: 20rpx; font-weight: 900; letter-spacing: 2rpx; }.observation text, .mate text { display: block; margin-top: 18rpx; color: #64748b; font-size: 26rpx; line-height: 1.7; font-weight: 700; }.action-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 28rpx; }.action-grid button { height: 104rpx; line-height: 104rpx; font-size: 25rpx; }.action-grid .full { grid-column: 1 / 3; }.danger { color: #e11d48; }.share-entry { margin-top: 28rpx; padding: 34rpx 40rpx 38rpx; }.share-main { min-width: 0; }.share-main text { display: block; margin-top: 10rpx; color: #64748b; font-size: 22rpx; font-weight: 800; line-height: 1.55; }.share-primary { width: 100%; height: 92rpx; margin-top: 28rpx; font-size: 24rpx; }.share-link-box { margin-top: 28rpx; padding: 24rpx 26rpx; border: 1rpx solid #e2e8f0; border-radius: 28rpx; background: #f8fafc; }.share-link { display: block; color: #0f172a; font-size: 20rpx; font-weight: 700; line-height: 1.6; word-break: break-all; }.share-hint { margin-top: 16rpx; color: #94a3b8; font-size: 18rpx; font-weight: 700; }.share-hint text { color: inherit; font-size: inherit; font-weight: inherit; }.share-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }.share-secondary, .share-revoke { flex: 1; height: 84rpx; line-height: 84rpx; margin: 0; padding: 0; border-radius: 24rpx; font-size: 22rpx; font-weight: 800; }.share-revoke { color: #be123c; background: #fff1f2; border: 1rpx solid #fecdd3; }.overlay { position: fixed; inset: 0; z-index: 60; display: flex; align-items: flex-end; padding: 28rpx; background: rgba(15,23,42,.68); }.modal { width: 100%; max-height: 88vh; overflow-y: auto; padding: 44rpx; border-radius: 40rpx; }.modal-title { color: #0f172a; font-size: 36rpx; font-weight: 900; }.close { color: #94a3b8; font-size: 48rpx; }.m