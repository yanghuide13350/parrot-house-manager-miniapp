.detail-top { position:fixed; top:calc(48rpx + env(safe-area-inset-top)); left:44rpx; right:44rpx; z-index:50; display:flex; align-items:center; justify-content:space-between; }
.detail-actions { display:flex; align-items:center; gap:12rpx; }
.round-button { width:88rpx; height:88rpx; padding:0; border:1rpx solid #e2e8f0; border-radius:28rpx; color:#0f172a; background:rgba(255,255,255,.94); box-shadow:0 8rpx 22rpx rgba(15,23,42,.12); }
.round-button.dark { border-color:#0f172a; color:#fff; background:#0f172a; }.danger-button { border-color:#fecdd3; color:#e11d48; background:#fff1f2; }.feeding-plan-button { border-color:#d9e4d5; background:#f4f8f1; }
.media-swiper { height:760rpx; background:#1e293b; }.media-item { position:relative; width:100%; height:100%; overflow:hidden; background:#1e293b; }.media-image { width:100%; height:100%; }.media-hint { position:absolute; bottom:24rpx; left:50%; z-index:2; padding:12rpx 22rpx; border-radius:24rpx; color:#fff; background:rgba(15,23,42,.62); font-size:20rpx; font-weight:800; transform:translateX(-50%); }.media-dots { position:absolute; top:680rpx; right:0; left:0; z-index:5; display:flex; justify-content:center; gap:10rpx; }.media-dot { width:12rpx; height:12rpx; border-radius:12rpx; background:#cbd5e1; }.media-dot.active { width:48rpx; background:#0f172a; }
.detail-body { position:relative; z-index:3; margin-top:-100rpx; }.identity-card, .relations-card, .breeding-history-card { margin-top:28rpx; padding:38rpx; border-radius:40rpx; }.identity-card { margin-top:0; }
.profile-title { color:#0f172a; font-size:42rpx; font-weight:900; }.profile-ring { margin-top:10rpx; color:#64748b; font-size:22rpx; font-weight:800; }.detail-grid { display:grid; grid-template-columns:1fr 1fr; gap:16rpx; margin-top:34rpx; }.detail-grid view { padding:24rpx; border-radius:24rpx; background:#f8fafc; }.detail-grid text { display:block; color:#64748b; font-size:20rpx; }.detail-grid strong { display:block; margin-top:8rpx; color:#0f172a; font-size:26rpx; }
.section-label { color:#0f172a; font-size:20rpx; font-weight:900; letter-spacing:2rpx; }.observation { margin-top:30rpx; padding-top:28rpx; border-top:1rpx solid #eef1f4; }.observation text { display:block; margin-top:14rpx; color:#64748b; font-size:23rpx; line-height:1.7; font-weight:700; }
.section-heading { margin-bottom:22rpx; }.section-heading text, .history-heading > view > text { display:block; margin-top:8rpx; color:#94a3b8; font-size:17rpx; font-weight:800; letter-spacing:1.5rpx; }.mate-row { display:flex; align-items:center; justify-content:space-between; min-height:98rpx; padding:16rpx 18rpx; border-radius:20rpx; background:#f8fafc; }.mate-row text:first-child, .lineage-item > text:first-child { display:block; color:#64748b; font-size:18rpx; font-weight:800; }.mate-row strong { display:block; margin-top:6rpx; color:#0f172a; font-size:26rpx; font-weight:900; }.chevron, .clutch-chevron { color:#94a3b8; font-size:38rpx; line-height:1; }
.lineage-grid { display:grid; grid-template-columns:1fr 1fr; gap:14rpx; margin-top:14rpx; }.lineage-item { min-width:0; min-height:126rpx; padding:18rpx; border-radius:20rpx; background:#f8fafc; }.lineage-item strong { display:-webkit-box; margin-top:8rpx; overflow:hidden; color:#0f172a; font-size:21rpx; font-weight:900; line-height:1.35; -webkit-box-orient:vertical; -webkit-line-clamp:2; }.lineage-link { display:block; margin-top:8rpx; color:#667085; font-size:18rpx; font-weight:800; }
.history-heading { align-items:flex-start; }.history-toggle { padding:12rpx 16rpx; border-radius:16rpx; color:#475569; background:#f1f5f9; font-size:19rpx; font-weight:800; }.clutch-row { margin-top:18rpx; padding:22rpx; border-radius:20rpx; background:#f8fafc; }.clutch-top { display:flex; align-items:center; justify-content:space-between; gap:20rpx; }.clutch-row strong, .clutch-row text { display:block; }.clutch-row strong { color:#0f172a; font-size:25rpx; }.clutch-top text { color:#2563eb; font-size:20rpx; font-weight:800; }.clutch-detail { margin-top:14rpx; }.clutch-detail text { color:#64748b; font-size:19rpx; line-height:1.55; }.clutch-birds { display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin-top:16rpx; padding:14rpx 16rpx; border-radius:16rpx; background:#fff; }.clutch-birds > view:first-child { min-width:0; flex:1; }.clutch-birds text { color:#475569; font-size:19rpx; font-weight:800; line-height:1.5; }.clutch-birds text:first-child { color:#0f172a; }.clutch-intake { width:100%; height:72rpx; margin-top:18rpx; border:0; border-radius:18rpx; color:#fff; background:#4f8175; font-size:20rpx; font-weight:800; }.clutch-intake-done { display:block; margin-top:18rpx; padding:16rpx; border-radius:16rpx; color:#166534; background:#f0fdf4; text-align:center; font-size:19rpx; }.empty-clutch { display:block; margin-top:18rpx; color:#94a3b8; font-size:22rpx; }.tap:active { opacity:.78; transform:scale(.99); }
.action-grid { display:grid; grid-template-columns:1fr 1fr; gap:18rpx; margin-top:28rpx; }.action-grid button { height:104rpx; font-size:25rpx; }.action-grid .full { grid-column:1 / 3; }.danger { color:#e11d48; }.action-grid .progress-button { border-color:#a9783d; background:#a9783d; }
.share-entry { margin-top:28rpx; padding:34rpx 40rpx 38rpx; }.share-main { min-width:0; }.share-main text { display:block; margin-top:10rpx; color:#64748b; font-size:22rpx; font-weight:800; line-height:1.55; }.share-primary { width:100%; height:92rpx; margin-top:28rpx; border-color:#806b99; background:#806b99; font-size:24rpx; }.share-link-box { margin-top:28rpx; padding:24rpx 26rpx; border:1rpx solid #e2e8f0; border-radius:28rpx; background:#f8fafc; }.share-link { display:block; color:#0f172a; font-size:20rpx; font-weight:700; line-height:1.6; word-break:break-all; }.share-hint { margin-top:16rpx; color:#94a3b8; font-size:18rpx; font-weight:700; }.share-actions { display:flex; gap:16rpx; margin-top:24rpx; }.share-secondary, .share-revoke { flex:1; height:84rpx; border-radius:24rpx; font-size:22rpx; font-weight:800; }.share-revoke { border:1rpx solid #fecdd3; color:#be123c; background:#fff1f2; }
.feeding-modal { max-height:82vh; }.guide { display:grid; gap:14rpx; margin-top:28rpx; padding:24rpx; border-radius:24rpx; color:#334155; background:#f8fafc; font-size:22rpx; line-height:1.55; font-weight:800; }.guide-section { margin-top:26rpx; }.guide-section strong,.guide-section text { display:block; }.guide-section strong { color:#0f172a; font-size:22rpx; }.guide-section text { margin-top:10rpx; color:#64748b; font-size:22rpx; line-height:1.65; white-space:pre-wrap; }.guide-change { width:100%; height:84rpx; margin-top:28rpx; font-size:23rpx; }.feeding-option { margin-top:18rpx; padding:22rpx; border:2rpx solid #eef1f4; border-radius:22rpx; }.feeding-option.selected { border-color:#0f172a; background:#f8fafc; }.feeding-option strong,.feeding-option text { display:block; }.feeding-option strong { color:#0f172a; font-size:24rpx; }.feeding-option text { margin-top:8rpx; color:#64748b; font-size:19rpx; }
.overlay { position:fixed; inset:0; z-index:60; display:flex; align-items:flex-end; padding:28rpx; background:rgba(15,23,42,.68); }.modal { width:100%; max-height:88vh; overflow-y:auto; padding:44rpx; border-radius:40rpx; }.modal-title { color:#0f172a; font-size:36rpx; font-weight:900; }.close { color:#94a3b8; font-size:48rpx; }.mate-list { margin-top:32rpx; }.mate-item { display:flex; align-items:center; gap:22rpx; padding:20rpx; margin-bottom:16rpx; border:2rpx solid #eef1f4; border-radius:24rpx; color:#0f172a; font-size:25rpx; font-weight:800; }.mate-item.selected { border-color:#0f172a; background:#f8fafc; }.mate-item image { width:88rpx; height:88rpx; border-radius:24rpx; }.mate-item text { display:block; margin-top:6rpx; color:#64748b; font-size:20rpx; }.empty-note { padding:50rpx 0; color:#94a3b8; text-align:center; font-weight:800; }.field-label { display:block; margin:28rpx 0 14rpx; color:#64748b; font-size:22rpx; font-weight:800; }.modal-submit { width:100%; height:92rpx; margin-top:34rpx; font-size:25rpx; }
