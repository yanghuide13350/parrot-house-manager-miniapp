.sales-header { display: flex; align-items: center; gap: 24rpx; padding-bottom: 48rpx; }
.sales-overview { display: flex; align-items: stretch; justify-content: space-between; padding: 42rpx; border-radius: 40rpx; background: #1e293b; color: #fff; }
.overview-main { display: flex; flex-direction: column; justify-content: center; }
.overview-label { color: rgba(255,255,255,.55); font-size: 20rpx; font-weight: 800; letter-spacing: 2rpx; }
.overview-value { margin-top: 12rpx; font-size: 50rpx; font-weight: 900; line-height: 1; }
.overview-stats { display: flex; align-items: center; gap: 32rpx; padding-left: 32rpx; border-left: 1rpx solid rgba(255,255,255,.14); }
.overview-stats view { min-width: 82rpx; text-align: center; }
.overview-stats strong { display: block; font-size: 28rpx; font-weight: 900; }
.overview-stats text { display: block; margin-top: 8rpx; color: rgba(255,255,255,.55); font-size: 18rpx; font-weight: 700; }
.sales-search { position: relative; margin-top: 28rpx; background: #fff; border: 1rpx solid #e2e8f0; border-radius: 24rpx; box-shadow: 0 8rpx 24rpx -4rpx rgba(30,41,59,.08); }
.sales-search input { height: 92rpx; padding: 0 28rpx 0 76rpx; color: #0f172a; font-size: 24rpx; font-weight: 700; line-height: 92rpx; }
.sales-search .search-mark { position: absolute; left: 26rpx; z-index: 2; }
.sales-list { margin-top: 28rpx; }
.sale-row { display: flex; gap: 24rpx; margin-bottom: 20rpx; padding: 24rpx; border: 1rpx solid #e8edf2; border-radius: 30rpx; background: #fff; box-shadow: 0 6rpx 20rpx rgba(30,41,59,.045); }
.sale-image { flex: 0 0 132rpx; width: 132rpx; height: 132rpx; border-radius: 24rpx; background: #f1f5f9; }
.sale-content { flex: 1; min-width: 0; }
.sale-head { gap: 16rpx; }
.sale-species { overflow: hidden; color: #0f172a; font-size: 25rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }
.visit { flex: none; width: auto; height: auto; min-height: 0; margin: 0; padding: 7rpx 14rpx; border-radius: 12rpx; font-size: 18rpx; font-weight: 900; line-height: 1.2; }
.visit.VISITED { color: #166534; background: #dcfce7; }.visit.WAITING { color: #92400e; background: #fef3c7; }.visit.UNREACHABLE { color: #9f1239; background: #ffe4e6; }
.sale-ring { margin-top: 9rpx; color: #64748b; font-size: 19rpx; font-weight: 800; }
.sale-divider { height: 1rpx; margin: 18rpx 0 14rpx; background: #f1f5f9; }
.sale-foot { align-items: flex-end; }
.sale-foot view text { display: block; margin-top: 4rpx; color: #64748b; font-size: 18rpx; font-weight: 700; }
.sale-foot strong { color: #0f172a; font-size: 27rpx; font-weight: 900; }
.sale-returned { opacity: .72; }.return-button { width: 100%; height: 64rpx; margin-top: 18rpx; border-radius: 18rpx; color: #be123c; background: #fff1f2; font-size: 20rpx; font-weight: 900; line-height: 64rpx; }.return-modal { width: 100%; padding: 44rpx; border-radius: 40rpx; }.modal-title { color: #0f172a; font-size: 34rpx; font-weight: 900; }.field-label { display: block; margin: 30rpx 0 14rpx; color: #64748b; font-size: 22rpx; font-weight: 800; }.textarea { min-height: 180rpx; }.modal-submit { width: 100%; height: 92rpx; margin-top: 28rpx; line-height: 92rpx; }
