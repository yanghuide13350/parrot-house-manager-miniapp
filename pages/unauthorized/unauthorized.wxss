.unauthorized { min-height: 100vh; box-sizing: border-box; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 64rpx; text-align: center; background: #fdfbf9; }.mark { width: 112rpx; height: 112rpx; border-radius: 50%; color: #be123c; background: #fff1f2; font-size: 56rpx; font-weight: 900; line-height: 112rpx; }.title { margin-top: 32rpx; color: #0f172a; font-size: 38rpx; font-weight: 900; }.detail { max-width: 560rpx; margin-top: 18rpx; color: #64748b; font-size: 24rpx; font-weight: 700; line-height: 1.7; }.openid { max-width: 600rpx; height: auto; margin-top: 28rpx; padding: 22rpx 28rpx; border: 1rpx solid #e2e8f0; border-radius: 20rpx; color: #334155; background: #fff; font-size: 20rpx; font-weight: 800; line-height: 1.5; word-break: break-all; }
