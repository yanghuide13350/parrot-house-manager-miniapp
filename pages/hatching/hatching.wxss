.head { display:flex; align-items:flex-end; justify-content:space-between; padding-bottom:44rpx; }
.add-button { width:112rpx; height:112rpx; padding:0; border-radius:44rpx; background:#1e293b; color:#fff; font-size:56rpx; font-weight:300; line-height:106rpx; }
.search-row { display:flex; }
.search-box { position:relative; width:100%; border:1rpx solid #e2e8f0; border-radius:24rpx; background:#fff; box-shadow:0 8rpx 24rpx -4rpx rgba(30,41,59,.08); }
.search-box input { height:92rpx; padding:0 70rpx; font-size:24rpx; font-weight:700; }
.search-mark { position:absolute; top:18rpx; left:24rpx; z-index:1; color:#64748b; font-size:42rpx; }
.clear { position:absolute; top:18rpx; right:24rpx; color:#94a3b8; font-size:42rpx; }
.records { padding-top:28rpx; }
.record { margin-bottom:28rpx; padding:28rpx 36rpx 32rpx; }
.parent-flow { display:flex; align-items:center; justify-content:space-between; gap:14rpx; padding:18rpx 0 22rpx; }
.parent-side { display:flex; flex:1; min-width:0; flex-direction:column; align-items:center; color:#64748b; font-size:19rpx; font-weight:800; }
.bird-role { margin-bottom:10rpx; color:#94a3b8; font-size:18rpx; font-weight:800; letter-spacing:.12em; }
.parent-avatar { width:150rpx; height:150rpx; border-radius:40rpx; background:#f1f5f9; }
.parent-avatar.tap:active { opacity:.72; transform:scale(.96); }
.parent-side strong { max-width:100%; margin-top:14rpx; overflow:hidden; color:#0f172a; font-size:24rpx; font-weight:900; text-overflow:ellipsis; white-space:nowrap; }
.parent-side small { margin-top:8rpx; color:#64748b; font-size:19rpx; font-weight:800; }
.hatching-state { display:flex; width:118rpx; flex-direction:column; align-items:center; gap:10rpx; }
.record-status { padding:10rpx 14rpx; border-radius:14rpx; color:#92400e; background:#fef3c7; font-size:19rpx; font-weight:900; white-space:nowrap; }
.record-status.done { color:#166534; background:#dcfce7; }
.state-count { color:#0f172a; font-size:28rpx; font-weight:900; white-space:nowrap; }
.state-label { color:#94a3b8; font-size:18rpx; font-weight:800; white-space:nowrap; }
.record-meta { display:flex; justify-content:space-between; gap:16rpx; padding:20rpx 0; border-top:1rpx solid #f1f5f9; color:#94a3b8; font-size:21rpx; font-weight:800; }
.record-meta text:last-child { text-align:right; }
.offspring-summary { margin-top:2rpx; padding:16rpx 18rpx; border-radius:16rpx; color:#4f8175; background:#f0fdf4; font-size:19rpx; font-weight:800; }
.record-actions { display:flex; gap:18rpx; margin-top:20rpx; }
.record-actions button { flex:1; height:84rpx; font-size:23rpx; line-height:84rpx; }
.completed-actions { margin-top:20rpx; }
.intake-button { width:100%; height:84rpx; font-size:23rpx; line-height:84rpx; }
.intake-complete { padding:20rpx; border-radius:18rpx; color:#166534; background:#f0fdf4; text-align:center; font-size:21rpx; font-weight:800; }
.remove-button { width:100%; height:76rpx; margin-top:18rpx; border:1rpx solid #fecdd3; border-radius:20rpx; color:#e11d48; background:#fff1f2; font-size:20rpx; font-weight:900; line-height:76rpx; }
.overlay { position:fixed; inset:0; z-index:60; display:flex; align-items:flex-end; padding:28rpx; background:rgba(15,23,42,.68); }
.modal { width:100%; max-height:90vh; overflow-y:auto; padding:44rpx; border-radius:40rpx; }
.modal-title { color:#0f172a; font-size:36rpx; font-weight:900; }
.close { color:#94a3b8; font-size:48rpx; }
.field-label { display:block; margin:30rpx 0 14rpx; color:#64748b; font-size:22rpx; font-weight:800; }
.field-label.top { margin-top:28rpx; }
.picker { width:100%; padding:26rpx 28rpx; border:1rpx solid #e2e8f0; border-radius:24rpx; color:#334155; background:#f8fafc; font-size:23rpx; font-weight:800; }
.modal-submit { width:100%; height:92rpx; margin-top:36rpx; font-size:25rpx; line-height:92rpx; }
.stepper { display:flex; align-items:center; justify-content:center; gap:48rpx; margin-top:52rpx; }
.stepper button { width:88rpx; height:88rpx; padding:0; border-radius:50%; color:#64748b; background:#f8fafc; font-size:44rpx; line-height:84rpx; }
.stepper text { min-width:120rpx; color:#0f172a; text-align:center; font-size:64rpx; font-weight:900; }
