.head { display: flex; align-items: flex-end; justify-content: space-between; padding-bottom: 44rpx; }.add-button { width: 112rpx; height: 112rpx; line-height: 106rpx; padding: 0; border-radius: 44rpx; background: #1e293b; color: #fff; font-size: 56rpx; font-weight: 300; }.search-row { display: flex; }.search-box { position: relative; width: 100%; background: #fff; border: 1rpx solid #e2e8f0; border-radius: 24rpx; box-shadow: 0 8rpx 24rpx -4rpx rgba(30,41,59,.08); }.search-box input { height: 92rpx; padding: 0 70rpx; font-size: 24rpx; font-weight: 700; }.search-mark { position: absolute; left: 24rpx; top: 18rpx; color: #64748b; font-size: 42rpx; z-index: 1; }.clear { position: absolute; right: 24rpx; top: 18rpx; color: #94a3b8; font-size: 42rpx; }.records { padding-top: 28rpx; }.record { margin-bottom: 24rpx; padding: 36rpx; }.record-species { color: #0f172a; font-size: 32rpx; font-weight: 900; }.record-rings { margin-top: 10rpx; color: #64748b; font-size: 20rpx; font-weight: 800; }.record-status { padding: 8rpx 16rpx; border-radius: 12rpx; color: #92400e; background: #fef3c7; font-size: 20rpx; font-weight: 900; }.record-status.done { color: #166534; background: #dcfce7; }.progress-row { display: flex; align-items: center; gap: 18rpx; margin-top: 38rpx; }.progress-track { flex: 1; height: 16rpx; overflow: hidden; border-radius: 16rpx; background: #f1f5f9; }.progress-fill { height: 100%; border-radius: 16rpx; background: #d6a85b; }.progress-row > text { color: #0f172a; font-size: 22rpx; font-weight: 900; }.record-meta { display: flex; justify-content: space-between; margin-top: 18rpx; color: #94a3b8; font-size: 19rpx; font-weight: 700; }.record-actions { display: flex; gap: 18rpx; margin-top: 28rpx; }.record-actions button { flex: 1; height: 80rpx; line-height: 80rpx; font-size: 22rpx; }.remove-button { width: 100%; height: 78rpx; line-height: 78rpx; margin-top: 28rpx; border-radius: 22rpx; color: #e11d48; background: #fff1f2; border: 1rpx solid #fecdd3; font-size: 21rpx; font-weight: 900; }.overlay { position: fixed; inset: 0; z-index: 60; display: flex; align-items: flex-end; padding: 28rpx; background: rgba(15,23,42,.68); }.modal { width: 100%; max-height: 90vh; overflow-y: auto; padding: 44rpx; border-radius: 40rpx; }.modal-title { color: #0f172a; font-size: 36rpx; font-weight: 900; }.close { color: #94a3b8; font-size: 48rpx; }.field-label { display: block; margin: 30rpx 0 14rpx; color: #64748b; font-size: 22rpx; font-weight: 800; }.field-label.top { margin-top: 28rpx; }.picker { width: 100%; padding: 26rpx 28rpx; border-radius: 24rpx; background: #f8fafc; border: 1rpx solid #e2e8f0; color: #334155; font-size: 23rpx; font-weight: 800; }.modal-submit { width: 100%; height: 92rpx; line-height: 92rpx; margin-top: 36rpx; font-size: 25rpx; }.stepper { display: flex; align-items: center; justify-content: center; gap: 48rpx; margin-top: 52rpx; }.stepper button { width: 88rpx; height: 88rpx; line-height: 84rpx; padding: 0; border-radius: 50%; background: #f8fafc; color: #64748b; font-size: 44rpx; }.stepper text { min-width: 120rpx; text-align: center; color: #0f172a; font-size: 64rpx; font-weight: 900; }
