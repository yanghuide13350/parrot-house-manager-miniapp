.home-head { display: flex; align-items: flex-end; justify-content: space-between; padding-bottom: 48rpx; }
.revenue { position: relative; overflow: hidden; background: #1e293b; color: #fff; border-radius: 48rpx; padding: 56rpx 48rpx; }
.revenue-mark { position: absolute; right: -10rpx; bottom: -32rpx; opacity: .07; transform: rotate(-12deg); filter: brightness(0) invert(1); pointer-events: none; }
.revenue-label { display: flex; align-items: center; gap: 14rpx; color: rgba(255,255,255,.45); font-size: 18rpx; font-weight: 900; letter-spacing: 4rpx; }
.live { width: 12rpx; height: 12rpx; border-radius: 50%; background: #34d399; }
.revenue-value { display: flex; align-items: baseline; gap: 14rpx; margin-top: 18rpx; font-size: 68rpx; font-weight: 900; letter-spacing: -3rpx; }
.revenue-value text:first-child { color: rgba(255,255,255,.38); font-size: 34rpx; font-weight: 400; }
.stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28rpx; margin-top: 32rpx; }
.stat { position: relative; height: 224rpx; border-radius: 44rpx; padding: 42rpx 36rpx; color: #fff; display: flex; flex-direction: column; justify-content: center; box-shadow: 0 12rpx 26rpx rgba(30,41,59,.16); text-shadow: 0 2rpx 4rpx rgba(15,23,42,.18); }
.stat-icon { position: absolute; top: 28rpx; right: 28rpx; display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; opacity: .74; filter: brightness(0) invert(1); pointer-events: none; text-shadow: none; }
.stat-illustration { top: 24rpx; right: 20rpx; width: 88rpx; height: 88rpx; opacity: 1; filter: none; }
.stat-illustration-vector { filter: brightness(0) invert(1); opacity: .92; }
.stat-illustration-image { display: block; width: 100%; height: 100%; }
.stat-num { color: #fff; font-size: 56rpx; font-weight: 900; line-height: 1; }
.stat-label { margin-top: 14rpx; color: #fff; font-size: 22rpx; font-weight: 900; }
.stat-blue { background: #60778b; }.stat-green { background: #899a7f; }.stat-pink { background: #d69da1; }.stat-beige { background: #bda170; }.stat-slate { background: #8794a0; }.stat-purple { background: #9e91ae; }
.quick-section { margin-top: 36rpx; }.quick-heading { display: flex; align-items: baseline; justify-content: space-between; margin: 0 4rpx 18rpx; }.quick-heading text:first-child { color: #0f172a; font-size: 28rpx; font-weight: 900; }.quick-heading text:last-child { color: #94a3b8; font-size: 17rpx; font-weight: 900; letter-spacing: 2rpx; }.quick-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }.quick-card { min-height: 190rpx; padding: 28rpx; border: 1rpx solid #edf1f5; border-radius: 32rpx; background: #fff; box-shadow: 0 10rpx 24rpx rgba(30,41,59,.04); }.quick-icon { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; border-radius: 24rpx; background: #f1f5f9; }.quick-name { margin-top: 20rpx; color: #0f172a; font-size: 25rpx; font-weight: 900; }.quick-card text { display: block; margin-top: 7rpx; color: #94a3b8; font-size: 16rpx; font-weight: 900; letter-spacing: 1.5rpx; }
.sales-entry { display: flex; align-items: center; padding: 36rpx; margin-top: 32rpx; }
.sales-icon { width: 96rpx; height: 96rpx; line-height: 96rpx; text-align: center; border-radius: 32rpx; background: #f1f5f9; color: #475569; font-size: 36rpx; font-weight: 900; }
.sales-entry-next, .access-entry { margin-top: 26rpx; }
.introduction-icon { display:flex; align-items:center; justify-content:center; background:#f1f5f9; }
.feeding-entry, .supplies-entry { margin-top: 22rpx; }.feeding-icon, .access-icon, .supplies-icon { display:flex; align-items:center; justify-content:center; background:#f1f5f9; color:#475569; }
.sales-copy { flex: 1; margin-left: 28rpx; color: #0f172a; font-size: 30rpx; font-weight: 900; }.sales-copy text { display: block; margin-top: 6rpx; color: #94a3b8; font-size: 18rpx; letter-spacing: 2rpx; }.chevron { color: #cbd5e1; font-size: 52rpx; }
.section { margin-top: 32rpx; }.bottom-section { padding-bottom: 32rpx; }
.chart-card, .distribution { position: relative; z-index: 0; padding: 42rpx; }.seg { display: flex; background: #f1f5f9; padding: 6rpx; border-radius: 16rpx; }.seg-item { padding: 12rpx 18rpx; color: #94a3b8; border-radius: 12rpx; font-size: 18rpx; font-weight: 900; }.seg-item.selected { color: #0f172a; background: #fff; box-shadow: 0 4rpx 10rpx rgba(30,41,59,.08); }
.chart { position: relative; z-index: 0; height: 260rpx; margin-top: 30rpx; overflow: hidden; isolation: isolate; border-bottom: 1rpx solid #f1f5f9; }.trend-canvas { position: relative; z-index: 0; width: 100%; height: 100%; }.chart-label { position: absolute; right: 10rpx; top: 12rpx; z-index: 1; color: #64748b; font-size: 20rpx; font-weight: 900; pointer-events: none; }
.mix { margin-top: 36rpx; color: #475569; font-size: 25rpx; font-weight: 700; }.mix-count { color: #0f172a; font-size: 23rpx; font-weight: 900; }.mix-percent { color: #94a3b8; font-size: 18rpx; margin-left: 8rpx; }.mix-track { height: 12rpx; margin-top: 14rpx; overflow: hidden; background: #f8fafc; border: 1rpx solid #f1f5f9; border-radius: 10rpx; }.mix-fill { height: 100%; background: linear-gradient(90deg,#7b8fa1,#cfb997); border-radius: 10rpx; }.empty-note { padding: 80rpx 0; text-align: center; color: #cbd5e1; font-weight: 800; }
