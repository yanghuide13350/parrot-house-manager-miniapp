<view class="page fade-in home">
  <view class="page-pad safe-top home-head"><view><view class="eyebrow">PRO MANAGEMENT</view><view class="title">管理概览</view></view></view>
  <view class="page-pad"><view class="revenue shadow-lg"><view class="revenue-mark"><app-icon name="feather" size="112"/></view><view class="revenue-label"><view class="live"></view> SALES REVENUE</view><view class="revenue-value"><text>¥</text><text>{{stats.revenue}}</text></view></view></view>
  <view class="page-pad stats-grid">
    <view class="stat stat-blue tap" data-filter="" bindtap="goParrots"><view class="stat-icon stat-illustration stat-illustration-vector"><app-icon name="feather" size="36"/></view><text class="stat-num">{{stats.total}}</text><text class="stat-label">鹦鹉总数</text></view>
    <view class="stat stat-green tap" data-filter="FOR_SALE" bindtap="goParrots"><view class="stat-icon stat-illustration"><image class="stat-illustration-image" src="/assets/icons/stat-sale-reference.png" mode="aspectFit"/></view><text class="stat-num">{{stats.forSale}}</text><text class="stat-label">待售</text></view>
    <view class="stat stat-pink tap" data-filter="SOLD" bindtap="goParrots"><view class="stat-icon stat-illustration"><image class="stat-illustration-image" src="/assets/icons/stat-sold-reference.png" mode="aspectFit"/></view><text class="stat-num">{{stats.sold}}</text><text class="stat-label">已售出</text></view>
    <view class="stat stat-beige tap" data-filter="BREEDER" bindtap="goParrots"><view class="stat-icon stat-illustration"><image class="stat-illustration-image" src="/assets/icons/stat-breeder-reference.png" mode="aspectFit"/></view><text class="stat-num">{{stats.breeder}}</text><text class="stat-label">种鸟</text></view>
    <view class="stat stat-slate tap" data-filter="PAIRED" bindtap="goParrots"><view class="stat-icon stat-illustration stat-illustration-vector"><app-icon name="orbit" size="36"/></view><text class="stat-num">{{stats.paired}}</text><text class="stat-label">已配对</text></view>
    <view class="stat stat-purple tap" data-filter="INCUBATING" bindtap="goParrots"><view class="stat-icon stat-illustration"><image class="stat-illustration-image" src="/assets/icons/stat-hatching-reference.png" mode="aspectFit"/></view><text class="stat-num">{{stats.incubating}}</text><text class="stat-label">孵化中</text></view>
  </view>
  <view class="page-pad"><view class="card sales-entry tap" bindtap="goSales"><view class="sales-icon">¥</view><view class="sales-copy"><view>销售记录</view><text>Sales & Follow-up</text></view><text class="chevron">›</text></view></view>
  <view class="page-pad"><view class="card sales-entry tap feeding-entry" bindtap="goFeedingPlans"><view class="sales-icon feeding-icon"><app-icon name="bottle" size="24"/></view><view class="sales-copy"><view>喂养方案</view><text>Care Plans & Buyer Guide</text></view><text class="chevron">›</text></view></view>
  <view wx:if="{{canManageAccess}}" class="page-pad"><view class="card sales-entry tap access-entry" bindtap="goAccess"><view class="sales-icon access-icon"><app-icon name="shield" size="22"/></view><view class="sales-copy"><view>权限管理</view><text>{{accessRole === 'OWNER' ? 'Owner Access Control' : 'Admin Review Queue'}}</text></view><text class="chevron">›</text></view></view>
  <view class="page-pad section"><view class="card chart-card"><view class="between"><text class="section-title">趋势洞察</text><view class="seg"><text class="seg-item {{trendMode === 'revenue' ? 'selected' : ''}}" data-mode="revenue" bindtap="setTrendMode">营收</text><text class="seg-item {{trendMode === 'volume' ? 'selected' : ''}}" data-mode="volume" bindtap="setTrendMode">数量</text></view></view><view class="chart"><canvas type="2d" id="trendCanvas" class="trend-canvas"></canvas><view class="chart-label">{{chartLabel}}</view></view></view></view>
  <view class="page-pad section bottom-section"><view class="card distribution"><view class="between"><text class="section-title">名称分布</text><text class="eyebrow">NAME MIX</text></view><view wx:if="{{species.length}}"><view wx:for="{{species}}" wx:key="name" class="mix"><view class="between"><text>{{item.name}}</text><text class="mix-count">{{item.count}} 只 <text class="mix-percent">{{item.percent}}%</text></text></view><view class="mix-track"><view class="mix-fill" style="width: {{item.percent}}%;"></view></view></view></view><view wx:else class="empty-note">暂无数据</view></view></view>
</view>
