.plan-view-page { display: flex; flex-direction: column; height: 100vh; overflow: hidden; background: #fdfbf9; }.view-head { display: flex; align-items: center; gap: 22rpx; padding-bottom: 34rpx; }.view-head > view { flex: 1; }.view-body { height: 0; flex: 1; }.plan-hero { display: flex; align-items: flex-start; justify-content: space-between; padding: 32rpx; border-radius: 32rpx; background: #17243b; color: #fff; }.hero-name { font-size: 32rpx; font-weight: 900; }.hero-meta { margin-top: 12rpx; color: #c9d2dd; font-size: 20rpx; font-weight: 700; }.hero-status { padding: 9rpx 14rpx; border-radius: 14rpx; background: rgba(255,255,255,.13); color: #d7dde5; font-size: 18rpx; font-weight: 900; }.hero-status.enabled { background: #dce8d9; color: #355445; }.detail-section { margin-top: 24rpx; padding: 30rpx; border: 1rpx solid #e9e4d9; border-radius: 30rpx; background: #fff; }.section-name { margin-bottom: 10rpx; color: #17243b; font-size: 25rpx; font-weight: 900; }.info-row, .note-row { display: flex; justify-content: space-between; gap: 24rpx; padding: 20rpx 0; border-top: 1rpx solid #eeeae2; color: #7d8490; font-size: 20rpx; font-weight: 800; }.info-row strong { max-width: 62%; color: #26364d; font-size: 21rpx; text-align: right; }.note-row { display: block; }.note-row > view { margin-top: 10rpx; color: #405168; font-size: 21rpx; font-weight: 700; line-height: 1.55; }.view-footer { display: flex; gap: 18rpx; padding: 20rpx 56rpx calc(22rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e9e5dc; background: #fffdfa; }.copy-button, .edit-button { flex: 1; height: 88rpx; border-radius: 24rpx; font-size: 24rpx; font-weight: 900; }.copy-button { border: 1rpx solid #d5d8d4; background: #fff; color: #425166; }
.plan-view-page { min-height: 0 !important; padding-bottom: 0 !important; }.view-footer { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
