<view class="page fade-in plan-view-page" wx:if="{{plan}}">
  <view class="page-pad safe-top view-head"><button class="back-button tap" bindtap="goBack"><app-icon name="arrow-left" size="22"/></button><view><view class="eyebrow">FEEDING PLANS</view><view class="title">方案详情</view></view></view>
  <scroll-view scroll-y show-scrollbar="{{false}}" class="view-body"><view class="page-pad">
    <view class="plan-hero"><view><view class="hero-name">{{plan.name}}</view><view class="hero-meta">{{plan.species}} · {{plan.stage}} · {{plan.ageLabel}}</view></view><text class="hero-status {{plan.isEnabled ? 'enabled' : ''}}">{{plan.isEnabled ? '已开启' : '未开启'}}</text></view>
    <view class="detail-section"><view class="section-name">食物方案</view><view class="info-row"><text>食物组合</text><strong>{{plan.foodLabel}}</strong></view><view wx:if="{{plan.feedingType !== 'SOLID'}}" class="info-row"><text>奶粉与比例</text><strong>{{plan.formulaName || '未填写'}} · {{plan.waterMl || '—'}}ml + {{plan.powderScoops || '—'}}</strong></view><view wx:if="{{plan.feedingType !== 'SOLID'}}" class="info-row"><text>水温</text><strong>{{plan.temperatureMin}}–{{plan.temperatureMax}}℃</strong></view><view wx:if="{{plan.feedingType !== 'FORMULA'}}" class="info-row"><text>谷子/固体食物</text><strong>{{plan.seedFoodName || '未填写'}} · {{plan.seedFoodAmount || '未填写'}}</strong></view><view wx:if="{{plan.feedingType !== 'FORMULA'}}" class="note-row"><text>处理说明</text><view>{{plan.seedFoodNotes || '未填写'}}</view></view></view>
    <view class="detail-section"><view class="section-name">喂养节奏</view><view class="info-row"><text>每天次数</text><strong>{{plan.feedingsPerDay || '—'}} 次</strong></view><view class="info-row"><text>单次参考量</text><strong>{{plan.amountMl || '未填写'}}</strong></view><view class="info-row"><text>喂养方式</text><strong>{{plan.feedingMethod || '未填写'}}</strong></view></view>
    <view class="detail-section"><view class="section-name">观察与提醒</view><view wx:if="{{plan.feedingType !== 'SOLID'}}" class="note-row"><text>水温判断</text><view>{{plan.temperatureCheck || '未填写'}}</view></view><view wx:if="{{plan.feedingType !== 'SOLID'}}" class="note-row"><text>冲泡说明</text><view>{{plan.preparationNotes || '未填写'}}</view></view><view class="note-row"><text>操作与注意</text><view>{{plan.feedingNotes || '未填写'}}</view></view><view class="note-row"><text>喂饱判断</text><view>{{plan.fullnessNotes || '未填写'}}</view></view><view class="note-row"><text>异常提醒</text><view>{{plan.warningNotes || '未填写'}}</view></view></view>
  </view></scroll-view>
  <view class="view-footer"><button class="copy-button" bindtap="copy">复制方案</button><button wx:if="{{!plan.isEnabled}}" class="button-dark edit-button" bindtap="edit">编辑方案</button></view>
</view>
