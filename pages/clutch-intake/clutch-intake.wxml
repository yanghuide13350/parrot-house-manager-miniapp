<view class="page fade-in intake-page">
  <view class="page-pad safe-top form-head"><button class="back-button tap" bindtap="goBack" aria-label="返回"><app-icon name="arrow-left" size="22"/></button><view><view class="eyebrow">CLUTCH INTAKE</view><view class="title">本窝幼鸟录入</view></view></view>
  <view wx:if="{{loaded && record}}" class="page-pad">
    <view class="parent-card card"><view class="section-label">已知血统 · LOCKED LINEAGE</view><view class="parents"><view><text>父鸟</text><strong>{{father.species}}<block wx:if="{{father.ringNumber}}"> · {{father.ringNumber}}</block></strong></view><view><text>母鸟</text><strong>{{mother.species}}<block wx:if="{{mother.ringNumber}}"> · {{mother.ringNumber}}</block></strong></view></view><view class="birth-row"><text>出生日期</text><strong>{{birthDateLabel}}</strong><text>本窝出壳 {{record.hatched}} 只</text></view></view>
    <view class="intake-note">父母血统、出生日期与窝次来源会自动写入，录入后不能在此修改。</view>
    <view wx:for="{{chicks}}" wx:for-item="chick" wx:for-index="chickIndex" wx:key="index" class="chick-card card"><view class="chick-title"><text>幼鸟 {{chick.index}}</text><text>本窝第 {{chick.index}} 只</text></view><text class="field-label">品种</text><input class="input" data-index="{{chickIndex}}" data-key="breed" value="{{chick.breed}}" bindinput="input" placeholder="如：玄凤、虎皮"/><text class="field-label">名称</text><input class="input" data-index="{{chickIndex}}" data-key="species" value="{{chick.species}}" bindinput="input" placeholder="如：黄化玄凤"/><text class="field-label">脚环 <text class="optional">（选填）</text></text><input class="input" data-index="{{chickIndex}}" data-key="ringNumber" value="{{chick.ringNumber}}" bindinput="input" placeholder="暂未佩戴可留空"/><text class="field-label">性别</text><view class="gender-tabs"><text wx:for="{{genders}}" wx:for-item="gender" wx:key="key" data-index="{{chickIndex}}" data-gender="{{gender.key}}" bindtap="chooseGender" class="gender-tab {{chick.gender === gender.key ? 'active' : ''}}">{{gender.label}}</text></view><text class="field-label">估值（¥）</text><input class="input" type="digit" data-index="{{chickIndex}}" data-key="price" value="{{chick.price}}" bindinput="input" placeholder="0"/><text class="field-label">备注</text><textarea class="textarea" data-index="{{chickIndex}}" data-key="privateNotes" value="{{chick.privateNotes}}" bindinput="input" placeholder="记录健康、喂养或其他观察信息（选填）"/></view>
    <button class="button-dark submit" disabled="{{submitting}}" bindtap="submit">{{submitting ? '正在批量录入...' : '确认录入本窝幼鸟'}}</button>
  </view>
  <view wx:else class="page-pad loading">正在加载本窝信息...</view>
</view>
