{
  "compilerOptions": {
    "target": "ES2018",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2018", "DOM"],
    "rootDir": ".",
    "outDir": "../.miniprogram-build",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "sourceMap": false,
    "declaration": false,
    "noEmit": false
  },
  "include": ["**/*.ts", "**/*.d.ts"],
  "exclude": ["../node_modules"]
}
