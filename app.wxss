page {
  background: #fdfbf9;
  color: #1e293b;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
  box-sizing: border-box;
}

view, scroll-view, swiper, button, input, textarea, image, video, text, canvas {
  box-sizing: border-box;
}

button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  line-height: 1.2;
}
button::after { border: 0; }

.page {
  min-height: 100vh;
  padding-bottom: calc(260rpx + env(safe-area-inset-bottom));
  background: #fdfbf9;
}

.page-pad { padding-left: 56rpx; padding-right: 56rpx; }
.safe-top { padding-top: calc(116rpx + env(safe-area-inset-top)); }
.glass {
  background: rgba(255, 255, 255, .88);
  border: 1rpx solid rgba(255, 255, 255, .8);
  box-shadow: 0 20rpx 40rpx -12rpx rgba(30, 41, 59, .12);
}
.shadow-sm { box-shadow: 0 8rpx 24rpx -4rpx rgba(30, 41, 59, .08); }
.shadow-lg { box-shadow: 0 24rpx 52rpx -16rpx rgba(30, 41, 59, .18); }
.card { background: #fff; border: 1rpx solid #eef1f4; border-radius: 36rpx; }
.muted { color: #64748b; }
.subtle { color: #94a3b8; }
.eyebrow { color: #94a3b8; font-size: 20rpx; font-weight: 800; letter-spacing: 4rpx; }
.title { color: #1e293b; font-size: 52rpx; font-weight: 900; line-height: 1.05; }
.section-title { color: #0f172a; font-size: 32rpx; font-weight: 900; }
.button-dark { background: #0f172a; color: #fff; border-radius: 28rpx; font-weight: 800; }
.button-light { background: #fff; color: #0f172a; border: 1rpx solid #e2e8f0; border-radius: 28rpx; font-weight: 800; }
.input { width: 100%; height: 88rpx; min-height: 88rpx; background: #f8fafc; border: 1rpx solid #e2e8f0; border-radius: 24rpx; padding: 0 28rpx; color: #0f172a; font-weight: 700; line-height: 88rpx; }
.input::placeholder, textarea::placeholder { color: #94a3b8; }
.row { display: flex; align-items: center; }
.between { display: flex; align-items: center; justify-content: space-between; }
.empty { padding: 120rpx 48rpx; text-align: center; color: #94a3b8; }
.divider { height: 1rpx; background: #f1f5f9; }
.danger { color: #e11d48; }
.tap { transition: transform .12s ease, opacity .12s ease; }
.tap:active { transform: scale(.97); opacity: .85; }
.fade-in { animation: fade-in .32s ease; }
@keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }

.overlay { z-index: 2000 !important; }
.drawer { max-height: calc(86vh - env(safe-area-inset-bottom)) !important; overflow-y: auto !important; }
.filter-button { display: flex !important; flex: 0 0 112rpx !important; align-items: center !important; justify-content: center !important; width: 112rpx !important; min-width: 112rpx !important; max-width: 112rpx !important; height: 92rpx !important; margin: 0 !important; padding: 0 !important; line-height: 1 !important; }
.search-box input { line-height: 92rpx !important; }
.search-mark { top: 50% !important; transform: translateY(-50%) !important; line-height: 0 !important; }
.quick-reset { display: flex !important; flex: 0 0 112rpx !important; align-items: center !important; justify-content: center !important; width: 112rpx !important; min-width: 112rpx !important; max-width: 112rpx !important; height: 92rpx !important; margin: 0 !important; padding: 0 !important; border: 1rpx solid #e2e8f0 !important; border-radius: 24rpx !important; background: #f8fafc !important; color: #475569 !important; font-size: 21rpx !important; font-weight: 900 !important; line-height: 1 !important; }
.back-button { display: flex !important; flex: 0 0 76rpx !important; align-items: center !important; justify-content: center !important; width: 76rpx !important; min-width: 76rpx !important; max-width: 76rpx !important; height: 76rpx !important; margin: 0 !important; padding: 0 !important; line-height: 1 !important; border-radius: 24rpx !important; }
.back-button, .viewer-back, .share-top > .round-button, .detail-top > .round-button { display: flex !important; flex: 0 0 76rpx !important; align-items: center !important; justify-content: center !important; width: 76rpx !important; min-width: 76rpx !important; max-width: 76rpx !important; height: 76rpx !important; min-height: 76rpx !important; margin: 0 !important; padding: 0 !important; border: 1rpx solid rgba(226,232,240,.94) !important; border-radius: 22rpx !important; color: #0f172a !important; background: rgba(255,255,255,.98) !important; box-shadow: 0 10rpx 22rpx rgba(15,23,42,.12) !important; line-height: 1 !important; }
.price-inputs { display: grid !important; grid-template-columns: minmax(0, 1fr) 28rpx minmax(0, 1fr) !important; align-items: center !important; width: 100% !important; }
.price-inputs .input { min-width: 0 !important; width: 100% !important; height: 88rpx !important; padding: 0 20rpx !important; line-height: 88rpx !important; }
.drawer-actions button { display: flex !important; align-items: center !important; justify-content: center !important; height: 96rpx !important; margin: 0 !important; padding: 0 !important; line-height: 1.2 !important; }
.action-grid button { min-width: 0 !important; width: 100% !important; margin: 0 !important; padding: 0 18rpx !important; line-height: 1.2 !important; }
.detail { overflow-x: hidden; }
.detail-top { top: calc(52rpx + env(safe-area-inset-top)) !important; left: 28rpx !important; right: 28rpx !important; align-items: center !important; }
.detail-actions { gap: 10rpx !important; }
.detail-top .round-button { display: flex !important; flex: 0 0 72rpx !important; align-items: center !important; justify-content: center !important; width: 72rpx !important; height: 72rpx !important; margin: 0 !important; padding: 0 !important; line-height: 1 !important; border-radius: 22rpx !important; }
.share-top { top: calc(52rpx + env(safe-area-inset-top)) !important; left: 28rpx !important; right: 28rpx !important; }
.breeder-pool { margin-top: 30rpx; }
.breeder-heading { margin-bottom: 24rpx; }
.pool-detail { margin-top: 8rpx; color: #94a3b8; font-size: 21rpx; font-weight: 700; }
.breeder-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 22rpx; }
.breeder-card { overflow: hidden; border-radius: 30rpx; }
.breeder-card > image { width: 100%; height: 220rpx; background: #f1f5f9; }
.breeder-copy { padding: 24rpx; }
.breeder-name { overflow: hidden; color: #0f172a; font-size: 24rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }
.breeder-ring { margin-top: 8rpx; color: #64748b; font-size: 18rpx; font-weight: 800; }
.breeder-action { margin-top: 20rpx; color: #1e293b; font-size: 20rpx; font-weight: 900; }

.add-button {
  display: flex !important;
  flex: 0 0 112rpx !important;
  align-items: center !important;
  justify-content: center !important;
  width: 112rpx !important;
  min-width: 112rpx !important;
  max-width: 112rpx !important;
  height: 112rpx !important;
  margin: 0 !important;
  padding: 0 !important;
}
